# Copy to .env and adjust. .env is never committed.
# Every setting the app reads is listed here (see src/config.js). Blank = the default shown.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL (development: 9.x; server: 8.0). Use a dedicated user, not root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jometech
DB_USERNAME=app_user
DB_PASSWORD=

# Signs the login cookie. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First admin, created by `npm run db:seed` only while no admin exists (must change the password at first login).
# Required on the server; development falls back to 0711 000 000 / jometech-admin-1.
ADMIN_NAME=Administrator
ADMIN_PHONE=
ADMIN_PASSWORD=

# Name in the browser tab and the server log.
APP_NAME=Jome-Tech
# Time zone for dates, times and yearly document numbers (CHK-2026-0001).
TIMEZONE=Africa/Nairobi
# Signatures and photos. Blank = the storage/ folder inside the app. Not public; include it in backups.
STORAGE_DIR=

# Letterhead on printed documents (receiving note; later quotations and invoices).
COMPANY_NAME=Jome-Tech Engineering Ltd
# Address lines separated by |
COMPANY_ADDRESS=Eastern Bypass, Ruai|P.O. Box 14554 - 00400, Nairobi
COMPANY_PHONE=0705 656 398
COMPANY_EMAIL=jometechltd@gmail.com
