{
  "name": "jometech",
  "version": "0.1.0",
  "private": true,
  "description": "Jome-Tech fabrication and workshop management system",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test",
    "db:migrate": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:rollback",
    "db:status": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:list",
    "db:make": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:make",
    "db:seed": "node --env-file-if-exists=.env node_modules/knex/bin/cli.js seed:run"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "alpinejs": "^3.17.5",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
