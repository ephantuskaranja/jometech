<%# System → Import data: one card per kind (template + upload), then the recent imports. %>
<%- include('partials/page-header', {
  crumb: ['System', 'Import data'],
  heading: 'Import data',
  sub: 'Load what Jome-Tech already has, for going live. Download the template, fill it in Excel, upload it, and check the preview: nothing is added until you press Import.',
}) %>

<div class="row g-4 mb-4">
  <% kinds.forEach((k) => { %>
    <div class="col-lg-6">
      <section class="card h-100">
        <div class="card-header"><h2 class="h6 mb-0"><%= k.TITLE %></h2></div>
        <div class="card-body d-grid gap-3">
          <ol class="small mb-0 ps-3">
            <li>Download the template: <a href="/admin/import/<%= k.KIND %>/template.xlsx"><i class="bi bi-file-earmark-spreadsheet"></i> <%= k.TITLE %> template</a>. The “How to fill” sheet explains each column.</li>
            <li>Fill in the <%= k.SHEETS.map((s) => `“${s.name}”`).join(' and ') %> sheet<%= k.SHEETS.length > 1 ? 's' : '' %>, one row each.</li>
            <li>Upload it here and check the preview.</li>
          </ol>
          <form method="post" action="/admin/import/<%= k.KIND %>" enctype="multipart/form-data" class="d-grid gap-2" x-data="uploadForm" @submit.prevent="send($el)">
            <input class="form-control" type="file" name="file" accept=".xlsx" required aria-label="The filled-in <%= k.TITLE %> file">
            <div><button class="btn btn-primary" type="submit" :disabled="busy"><span x-show="busy" class="spinner-border spinner-border-sm" aria-hidden="true"></span><i class="bi bi-upload" x-show="!busy"></i>Upload and check</button></div>
            <div class="jt-error-text" x-show="error" x-cloak x-text="error"></div>
          </form>
        </div>
      </section>
    </div>
  <% }) %>
</div>

<section class="card">
  <div class="card-header"><h2 class="h6 mb-0">Recent imports</h2></div>
  <% if (!recent.length) { %>
    <div class="card-body small text-body-secondary">None yet.</div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table jt-table mb-0">
        <thead><tr><th>File</th><th>What</th><th>Result</th><th>By</th><th>When</th></tr></thead>
        <tbody>
          <% recent.forEach((r) => { %>
            <tr>
              <td><a class="jt-row-link" href="/admin/import/<%= r.id %>"><%= r.file_name %></a></td>
              <td><%= r.title %></td>
              <td><%- include('partials/pill', { text: { preview: 'Waiting for you', done: 'Imported', discarded: 'Discarded' }[r.status], tone: { preview: 'warn', done: 'ok', discarded: 'neutral' }[r.status] }) %>
                <% if (r.summary) { %><div class="small text-body-secondary"><%= r.summary %></div><% } %></td>
              <td><%= r.by ?? '—' %></td>
              <td class="text-nowrap small"><%= fmt.dateTime(r.created_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
