<%# System → Quality checklist: sections of items, each section with the step that redoes its work. Saved all at once. %>
<%- include('partials/page-header', {
  crumb: ['System', 'Quality checklist'],
  heading: 'Quality checklist',
  sub: 'What a quality check goes through. New checks use this list; checks already done keep the list they had.',
  actions: [{ label: 'Print blank form', href: '/qc-form/print', icon: 'printer' }],
}) %>

<div class="row g-4">
  <div class="col-lg-8">
    <form method="post" action="/admin/qc-checklist" novalidate x-data="qcChecklist(<%= JSON.stringify({ sections }) %>)" @submit="pack()">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="checklist" x-ref="data">
      <datalist id="qc-steps"><% stepNames.forEach((s) => { %><option value="<%= s %>"></option><% }) %></datalist>
      <% if (errors) { %><div class="alert alert-warning" role="alert"><i class="bi bi-exclamation-triangle"></i> <%= errors %></div><% } %>

      <div class="d-grid gap-4">
        <template x-for="(section, si) in sections" :key="section.key">
          <section class="card">
            <div class="card-header d-flex flex-wrap gap-2 align-items-center">
              <span class="fw-semibold" x-text="`${String.fromCharCode(65 + si)}.`"></span>
              <input class="form-control form-control-sm fw-semibold" style="max-width: 22rem" x-model="section.name" maxlength="80" placeholder="Section, e.g. Welding" :aria-label="`Section ${si + 1} name`">
              <span class="ms-auto d-flex gap-1">
                <button type="button" class="btn jt-icon-btn" @click="moveSection(si, -1)" :disabled="si === 0" aria-label="Move section up"><i class="bi bi-arrow-up"></i></button>
                <button type="button" class="btn jt-icon-btn" @click="moveSection(si, 1)" :disabled="si === sections.length - 1" aria-label="Move section down"><i class="bi bi-arrow-down"></i></button>
                <button type="button" class="btn jt-icon-btn" @click="removeSection(si)" aria-label="Remove section"><i class="bi bi-trash"></i></button>
              </span>
            </div>
            <div class="card-body d-grid gap-2">
              <template x-for="(item, ii) in section.items" :key="item.key">
                <div class="jt-step-row">
                  <span class="jt-items-no" x-text="ii + 1"></span>
                  <input class="form-control" x-model="item.text" maxlength="200" placeholder="e.g. No cracks in the welds" @keydown.enter.prevent="addItem(section, ii)" :aria-label="`Item ${ii + 1}`">
                  <button type="button" class="btn jt-icon-btn" @click="moveItem(section, ii, -1)" :disabled="ii === 0" aria-label="Move item up"><i class="bi bi-arrow-up"></i></button>
                  <button type="button" class="btn jt-icon-btn" @click="moveItem(section, ii, 1)" :disabled="ii === section.items.length - 1" aria-label="Move item down"><i class="bi bi-arrow-down"></i></button>
                  <button type="button" class="btn jt-icon-btn" @click="removeItem(section, ii)" aria-label="Remove item"><i class="bi bi-x-lg"></i></button>
                </div>
              </template>
              <div><button type="button" class="btn btn-outline-secondary btn-sm" @click="addItem(section, section.items.length - 1)"><i class="bi bi-plus-lg"></i>Add an item</button></div>
              <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                <label class="small text-body-secondary" :for="`rw-${section.key}`">If an item fails, redo the work at</label>
                <input class="form-control form-control-sm" style="max-width: 16rem" list="qc-steps" :id="`rw-${section.key}`" x-model="section.rework_step" maxlength="60" placeholder="a production step, e.g. Painting">
              </div>
            </div>
          </section>
        </template>
        <div><button type="button" class="btn btn-outline-secondary" @click="addSection()"><i class="bi bi-plus-lg"></i>Add a section</button></div>
      </div>

      <div class="jt-savebar">
        <span class="jt-savebar-note"><i class="bi bi-list-check"></i><span x-text="`${sections.length} sections, ${sections.reduce((n, s) => n + s.items.filter((i) => i.text.trim()).length, 0)} items`"></span></span>
        <div class="jt-savebar-actions">
          <a class="btn btn-outline-secondary" href="/admin/qc-checklist">Cancel</a>
          <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i>Save</button>
        </div>
      </div>
    </form>
  </div>
  <div class="col-lg-4 d-grid gap-4 align-content-start">
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">How it is used</h2></div>
      <div class="card-body small d-grid gap-2">
        <p class="mb-0">When a job reaches its quality check step (set per job type under Job types &amp; steps), the supervisor marks each item Pass, Fail or N/A.</p>
        <p class="mb-0">Any failure fails the check. “Redo the work at” suggests the step a failed item goes back to.</p>
      </div>
    </section>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">History</h2></div>
      <div class="card-body"><%- include('partials/history', { entries, labels: { checklist: 'Checklist' } }) %></div>
    </section>
  </div>
</div>
