<%#
  Pricing guide on a proforma, for managers and admins (costing.view): what similar completed jobs
  really cost and the price for the target margin (System → Pricing). pricingGuide in public/js/app.js.
  Locals: guide: { types: [{ value, label }], type, fixedTotal (null inside the form), vatRate, narrow (a side column) }
%>
<% const col = (sm) => (guide.narrow ? 'col-12' : `col-sm-${sm}`); %>
<section class="card jt-guide<%= guide.narrow ? ' is-narrow' : '' %>" x-data="pricingGuide(<%= JSON.stringify({ type: guide.type ?? '', fixedTotal: guide.fixedTotal ?? null, vatRate: guide.vatRate }) %>)">
  <div class="card-header d-flex align-items-center gap-2">
    <h2 class="h6 mb-0 me-auto text-nowrap"><i class="bi bi-lightbulb"></i> Pricing guide</h2>
    <span class="small text-body-tertiary"><%= guide.narrow ? 'Managers only' : 'Only managers and admins see this' %></span>
  </div>
  <div class="card-body d-grid gap-3">
    <div class="row g-2">
      <div class="<%= col(5) %>">
        <label class="form-label small mb-1" for="guide-type">Compare with</label>
        <select class="form-select form-select-sm" id="guide-type" x-model="type" @change="load()">
          <option value="">Any job type</option>
          <% guide.types.forEach((t) => { %><option value="<%= t.value %>"><%= t.label %></option><% }) %>
        </select>
      </div>
      <div class="<%= col(7) %>">
        <label class="form-label small mb-1" for="guide-q">With these words in the work</label>
        <input class="form-control form-control-sm" id="guide-q" x-model="q" @input="later()" @keydown.enter.prevent="load()" placeholder="e.g. tipper, canopy, 20 ft" autocomplete="off">
      </div>
    </div>

    <div x-show="loading" class="small text-body-secondary"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Looking at past jobs…</div>
    <div x-show="failed" x-cloak class="small text-danger-emphasis">The guide didn’t load. <button type="button" class="btn btn-link btn-sm p-0" @click="load()">Try again</button></div>

    <template x-if="data && !data.count && !loading">
      <p class="small text-body-secondary mb-0">No completed jobs like this in the last 12 months with a price. Try another job type, or fewer words.</p>
    </template>

    <template x-if="data && data.count && !loading">
      <div class="d-grid gap-3">
        <div class="jt-guide-suggest">
          <div class="small text-body-secondary">Suggested price for a <strong x-text="`${data.target}%`"></strong> margin</div>
          <div class="jt-guide-price jt-num" x-text="`KES ${money(data.suggestedWithVat)}`"></div>
          <div class="small text-body-secondary">with VAT · <span x-text="`KES ${money(data.suggestedExVat)}`"></span> without</div>
        </div>
        <template x-if="price">
          <div class="small" :class="expectedMargin < 0 ? 'text-danger-emphasis' : expectedMargin < data.target ? 'text-warning-emphasis' : 'text-success-emphasis'">
            <i class="bi" :class="expectedMargin < data.target ? 'bi-exclamation-triangle' : 'bi-check-circle'"></i>
            This proforma, <strong x-text="`KES ${money(price)}`"></strong>, gives about <strong x-text="`${expectedMargin}%`"></strong> margin if the job costs as much as usual.
          </div>
        </template>
        <dl class="jt-costing mb-0">
          <div><dt>Usual cost</dt><dd class="jt-num" x-text="`KES ${money(data.avgCost)}`"></dd>
            <dd class="jt-costing-note" x-text="`From KES ${money(data.minCost)} to ${money(data.maxCost)}: materials, wages and running costs`"></dd></div>
          <div><dt>Sold for, on average</dt><dd class="jt-num" x-text="`KES ${money(data.avgPrice)}`"></dd>
            <dd class="jt-costing-note" x-text="`Without VAT, at ${data.avgMargin}% margin; about ${data.avgDays} work days`"></dd></div>
        </dl>
        <div class="small text-body-secondary">
          Based on <strong x-text="data.count"></strong> completed job<span x-show="data.count !== 1">s</span> in the last 12 months.
          <span x-show="data.incomplete" class="text-warning-emphasis" x-text="`${data.incomplete} of them ${data.incomplete === 1 ? 'doesn’t' : 'don’t'} carry all their wages or running costs yet, so the usual cost may be low.`"></span>
        </div>
        <ul class="list-unstyled small mb-0 jt-guide-jobs">
          <template x-for="j in data.recent" :key="j.id">
            <li class="d-flex gap-2">
              <a class="font-monospace" :href="`/jobs/${j.id}`" x-text="j.number" target="_blank" rel="noopener"></a>
              <span class="text-body-secondary text-truncate me-auto" x-text="j.customer"></span>
              <span class="jt-num text-nowrap" x-text="`cost ${money(j.cost)} · sold ${money(j.price)}`"></span>
            </li>
          </template>
        </ul>
      </div>
    </template>
  </div>
</section>
