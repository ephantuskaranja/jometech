<%#
  System → Closed days. Sundays never count as work days; most public holidays do at Jome-Tech.
  The days listed here (for every site or one) are left out of a job's work days too.
%>
<% const dayText = (d) => fmt.date(`${d}T12:00:00Z`); const weekday = (d) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' }); %>
<%- include('partials/page-header', {
  crumb: ['System', 'Closed days'],
  heading: 'Closed days',
  sub: 'Days the workshop didn’t work, such as Christmas. Sundays are never counted; the days listed here are left out of a job’s work days too.',
}) %>

<div class="row g-4">
  <div class="col-lg-5">
    <form method="post" action="/admin/closed-days" novalidate class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header"><h2 class="h6 mb-0">Add a closed day</h2></div>
      <div class="card-body d-grid gap-3">
        <%- include('partials/field', { name: 'day', label: 'Day', type: 'date', value: values.day, error: errors.day, required: true }) %>
        <%- include('partials/field', { name: 'site_id', label: 'Site', type: 'select', value: String(values.site_id ?? ''), error: errors.site_id,
          options: [{ value: '', label: 'Every site' }, ...sites.map((s) => ({ value: String(s.id), label: s.name }))] }) %>
        <%- include('partials/field', { name: 'reason', label: 'Why', value: values.reason, error: errors.reason, required: true, placeholder: 'e.g. Christmas Day' }) %>
        <div><button class="btn btn-primary" type="submit"><i class="bi bi-calendar-x"></i>Mark as closed</button></div>
      </div>
    </form>
  </div>

  <div class="col-lg-7 d-grid gap-4 align-content-start">
    <% [['Coming up', coming], ['Past', past]].forEach(([heading, list]) => { %>
      <section class="card">
        <div class="card-header"><h2 class="h6 mb-0"><%= heading %></h2></div>
        <% if (!list.length) { %>
          <div class="card-body small text-body-secondary"><%= heading === 'Coming up' ? 'No closed days coming up.' : 'None yet.' %></div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% list.forEach((d) => { %>
              <li class="list-group-item d-flex align-items-center gap-3 flex-wrap">
                <div class="me-auto">
                  <div class="fw-semibold"><%= dayText(d.day) %> <span class="small text-body-secondary fw-normal"><%= weekday(d.day) %></span></div>
                  <div class="small text-body-secondary"><%= d.reason %> · <%= d.site_name ?? 'Every site' %><%= d.created_by_name ? ` · added by ${d.created_by_name}` : '' %></div>
                </div>
                <form method="post" action="/admin/closed-days/<%= d.id %>/delete" x-data @submit="if (!confirm('Remove this closed day? Jobs will count it as a work day again.')) $event.preventDefault()">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-link btn-sm text-body-secondary p-0" type="submit">Remove</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    <% }) %>
  </div>
</div>
