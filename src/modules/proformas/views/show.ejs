<%# One proforma: its lines and total, and what happens next (send, accepted / declined, revise, copy). %>
<%
  const st = statuses[proforma.status];
  const lines = (text) => String(text).split('\n');
%>
<section class="card mb-4">
  <div class="card-body jt-record">
    <div class="jt-crumb">Sales <i class="bi bi-chevron-right"></i><a href="/proformas">Proformas</a><i class="bi bi-chevron-right"></i><span><%= proforma.number %></span></div>
    <div class="jt-record-top">
      <div class="jt-record-title">
        <h1 class="h3">Proforma <%= proforma.number %> <%- include('partials/pill', { text: st.label, tone: st.tone }) %></h1>
        <div class="jt-meta">
          <span><i class="bi bi-person"></i><a href="/customers/<%= proforma.customer_id %>"><%= proforma.customer_name %></a></span>
          <span><i class="bi bi-calendar"></i><%= fmt.date(`${proforma.proforma_date}T12:00:00Z`) %></span>
          <span><i class="bi bi-cash"></i>KES <%= fmt.money(proforma.total) %></span>
          <% if (proforma.enquiry_id) { %><span><i class="bi bi-inbox"></i><a href="/enquiries/<%= proforma.enquiry_id %>"><%= proforma.enquiry_number %></a></span><% } %>
        </div>
      </div>
      <div class="jt-page-actions">
        <% if (proforma.status === 'draft') { %><a class="btn btn-outline-secondary" href="/proformas/<%= proforma.id %>/edit"><i class="bi bi-pencil"></i>Edit</a><% } %>
        <a class="btn btn-outline-secondary" href="/proformas/new?copy=<%= proforma.id %>"><i class="bi bi-files"></i>Copy</a>
        <a class="btn btn-primary" href="/proformas/<%= proforma.id %>/print"><i class="bi bi-printer"></i>Print or PDF</a>
      </div>
    </div>
  </div>
</section>

<% if (proforma.status === 'replaced') { %>
  <div class="jt-info-box mb-4"><i class="bi bi-arrow-right-circle"></i><span>This version was replaced by <a href="/proformas/<%= proforma.replaced_by %>"><strong><%= proforma.replaced_by_number %></strong></a>. It is kept as it was sent.</span></div>
<% } %>

<div class="row g-4">
  <div class="col-lg-8 d-grid gap-4 align-content-start">
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">What is offered</h2></div>
      <div class="table-responsive">
        <table class="table jt-table mb-0">
          <thead><tr><th>Qty</th><th>Description</th><th class="text-end">@</th><th class="text-end">Amount (KES)</th></tr></thead>
          <tbody>
            <% proforma.lines.forEach((l) => { %>
              <tr>
                <td class="text-nowrap"><%= fmt.qty(l.quantity) %> <%= l.unit %></td>
                <td>
                  <% lines(l.description).forEach((text) => { const bullet = /^\s*[-•*]\s+/.test(text); %>
                    <div class="<%= bullet ? 'jt-bullet' : '' %>"><%= bullet ? text.replace(/^\s*[-•*]\s+/, '') : text %></div>
                  <% }) %>
                </td>
                <td class="text-end jt-num"><%= fmt.money(l.unit_price) %></td>
                <td class="text-end jt-num"><%= fmt.money(l.amount) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr><th colspan="3" class="text-end">Total (VAT included)</th><th class="text-end jt-num">KES <%= fmt.money(proforma.total) %></th></tr>
            <tr class="small text-body-secondary"><td colspan="3" class="text-end">of which VAT <%= vatRate %>%</td><td class="text-end jt-num"><%= fmt.money(vat) %></td></tr>
          </tfoot>
        </table>
      </div>
      <% if (proforma.notes) { %><div class="card-body border-top small" style="white-space: pre-line"><%= proforma.notes %></div><% } %>
    </section>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">History</h2></div>
      <div class="card-body"><%- include('partials/history', { entries, labels: {} }) %></div>
    </section>
  </div>

  <div class="col-lg-4 d-grid gap-4 align-content-start">
    <section class="card" x-data="{ step: '' }">
      <div class="card-header"><h2 class="h6 mb-0">Next step</h2></div>
      <div class="card-body d-grid gap-3">
        <% if (proforma.status === 'draft') { %>
          <p class="small mb-0">Check it and print it. Once the customer has it, mark it as sent: it is then locked, and changes go in a revision.</p>
          <form method="post" action="/proformas/<%= proforma.id %>/send">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-send"></i>Mark as sent</button>
          </form>

        <% } else if (proforma.status === 'sent') { %>
          <p class="small mb-0">Sent <%= fmt.dateTime(proforma.sent_at) %>. What did the customer say?</p>
          <div class="d-flex flex-wrap gap-2" x-show="!step">
            <button type="button" class="btn btn-outline-success" @click="step = 'accept'"><i class="bi bi-hand-thumbs-up"></i>Accepted</button>
            <button type="button" class="btn btn-outline-secondary" @click="step = 'decline'"><i class="bi bi-x-circle"></i>Declined</button>
            <button type="button" class="btn btn-outline-primary" @click="step = 'revise'"><i class="bi bi-pencil-square"></i>Wants changes</button>
          </div>
          <div x-show="step === 'accept'" x-cloak>
            <form method="post" action="/proformas/<%= proforma.id %>/accept" class="d-grid gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <p class="small mb-0">The customer agreed to <%= proforma.number %> at KES <%= fmt.money(proforma.total) %>.<%= proforma.enquiry_id ? ' The enquiry closes as won.' : '' %></p>
              <div class="d-flex gap-2"><button class="btn btn-success" type="submit">Yes, accepted</button><button class="btn btn-link" type="button" @click="step = ''">Cancel</button></div>
            </form>
          </div>
          <div x-show="step === 'decline'" x-cloak>
            <form method="post" action="/proformas/<%= proforma.id %>/decline" class="d-grid gap-2" x-data="{ reason: '' }">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <fieldset class="jt-field">
                <legend class="form-label">Why did they decline?</legend>
                <div class="jt-choices" style="--jt-cols: 1">
                  <% [...declineReasons, 'other'].forEach((r, i) => { %>
                    <label class="jt-choice" for="dec-<%= i %>"><input class="form-check-input" type="radio" id="dec-<%= i %>" name="reason" value="<%= r %>" x-model="reason"><span class="jt-choice-label"><%= r === 'other' ? 'Something else' : r %></span></label>
                  <% }) %>
                </div>
              </fieldset>
              <div x-show="reason === 'other'"><%- include('partials/field', { name: 'other_reason', label: 'Reason', placeholder: 'e.g. Bought a ready-made body' }) %></div>
              <div class="d-flex gap-2"><button class="btn btn-secondary" type="submit" :disabled="!reason">Mark declined</button><button class="btn btn-link" type="button" @click="step = ''">Cancel</button></div>
            </form>
          </div>
        <% } else if (proforma.status === 'accepted') { %>
          <div><%- include('partials/pill', { text: st.label, tone: st.tone }) %> <span class="small text-body-secondary"><%= fmt.dateTime(proforma.closed_at) %></span></div>
          <% if (proforma.job) { %>
            <a class="btn btn-outline-primary" href="/jobs/<%= proforma.job.id %>"><i class="bi bi-wrench-adjustable"></i>Open job <%= proforma.job.number %></a>
          <% } else { %>
            <form method="post" action="/proformas/<%= proforma.id %>/job">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary w-100" type="submit"><i class="bi bi-wrench-adjustable"></i>Start the job</button>
            </form>
          <% } %>
        <% } else if (proforma.status === 'declined') { %>
          <div><%- include('partials/pill', { text: st.label, tone: st.tone }) %> <span class="small text-body-secondary"><%= fmt.dateTime(proforma.closed_at) %></span>
            <div class="mt-1"><%= proforma.declined_reason %></div></div>
          <p class="small mb-0">If they come back, revise it with a new price or specification.</p>
          <button type="button" class="btn btn-outline-primary" x-show="!step" @click="step = 'revise'"><i class="bi bi-pencil-square"></i>Revise</button>
        <% } else { %>
          <p class="small text-body-secondary mb-0">Replaced: see <a href="/proformas/<%= proforma.replaced_by %>"><%= proforma.replaced_by_number %></a>.</p>
        <% } %>

        <% if (['sent', 'declined'].includes(proforma.status)) { %>
          <div x-show="step === 'revise'" x-cloak>
            <form method="post" action="/proformas/<%= proforma.id %>/revise" class="d-grid gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <p class="small mb-0">This makes <strong><%= proforma.base_no %>-R<%= proforma.versions.length %></strong>, a copy you can change. <%= proforma.number %> stays as it was sent, marked “replaced”.</p>
              <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Make a revision</button><button class="btn btn-link" type="button" @click="step = ''">Cancel</button></div>
            </form>
          </div>
        <% } %>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">For</h2></div>
      <div class="card-body">
        <dl class="jt-kv">
          <div><dt>Customer</dt><dd><a href="/customers/<%= proforma.customer_id %>"><%= proforma.customer_name %></a> <span class="text-body-tertiary small text-nowrap"><%= proforma.customer_number %></span></dd></div>
          <div><dt>KRA PIN</dt><dd class="font-monospace"><%= proforma.customer_pin ?? '—' %></dd></div>
          <div><dt>Vehicle</dt><dd><% if (proforma.vehicle_id) { %><a href="/vehicles/<%= proforma.vehicle_id %>"><%= proforma.vehicle_label %></a><% } else { %><%= proforma.vehicle_description ?? '—' %><% } %></dd></div>
          <div><dt>Prepared by</dt><dd><%= proforma.created_name ?? '—' %></dd></div>
        </dl>
        <% if (!proforma.customer_pin) { %><div class="form-text">The paper proforma shows the customer’s KRA PIN. Add it on the <a href="/customers/<%= proforma.customer_id %>/edit">customer</a> if they need it.</div><% } %>
      </div>
    </section>

    <% if (proforma.versions.length > 1) { %>
      <section class="card">
        <div class="card-header"><h2 class="h6 mb-0">Versions</h2></div>
        <ul class="list-group list-group-flush">
          <% proforma.versions.forEach((v) => { const vs = statuses[v.status]; %>
            <li class="list-group-item d-flex align-items-center gap-2<%= v.id === proforma.id ? ' fw-semibold' : '' %>">
              <a href="/proformas/<%= v.id %>" class="font-monospace"><%= v.number %></a>
              <%- include('partials/pill', { text: vs.label, tone: vs.tone }) %>
              <span class="ms-auto jt-num small">KES <%= fmt.money(v.total) %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </div>
</div>
