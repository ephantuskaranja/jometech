<%# Check-in → Movements → "Send a vehicle": the vehicles in the workshop here that can be sent; each opens its check-in with the send form. %>
<%- include('partials/page-header', {
  crumb: [{ label: 'Check-in', href: '/check-in' }, { label: 'Movements', href: '/check-in?show=moves' }, 'Send a vehicle'],
  heading: 'Send a vehicle to another site',
  sub: others.length ? `Choose the vehicle. Its check-in opens with the send form: where to (${others.map((s) => s.name).join(', ')}), the driver and the people in it.` : 'There is no other site to send to.',
  sort: 'Latest checked in first',
}) %>

<section class="card">
  <% if (!list.length || !others.length) { %>
    <%- include('partials/empty', { icon: 'truck', heading: 'No vehicle to send', text: others.length ? 'Only vehicles in the workshop here, and not already on their way, can be sent.' : 'Add another site first.', action: { label: 'Back to movements', href: '/check-in?show=moves' } }) %>
  <% } else { %>
    <ul class="list-group list-group-flush">
      <% list.forEach((c) => { %>
        <li class="list-group-item d-flex flex-wrap gap-3 align-items-center">
          <% if (c.reg_no) { %><%- include('partials/plate', { reg: c.reg_no }) %><% } else { %><strong class="font-monospace"><%= vehicleLabel(c) %></strong><% } %>
          <div class="flex-grow-1">
            <div class="fw-semibold"><%= [c.make, c.model].filter(Boolean).join(' ') || 'Vehicle' %></div>
            <div class="small text-body-secondary"><%= c.customer_name %> · <span class="font-monospace"><%= c.number %></span> · in since <%= fmt.date(c.checked_in_at) %></div>
          </div>
          <a class="btn btn-primary btn-sm" href="/check-in/<%= c.id %>?send=1"><i class="bi bi-send"></i>Send</a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
