<%# Send a checked-in vehicle to another site (from the check-in page's header, or Movements → Send a vehicle). %>
<%- include('partials/page-header', {
  crumb: [{ label: 'Check-in', href: '/check-in' }, { label: checkin.number, href: `/check-in/${checkin.id}` }, 'Send to another site'],
  heading: `Send ${vehicleLabel(checkin)} to another site`,
  sub: `${[checkin.make, checkin.model].filter(Boolean).join(' ') || 'Vehicle'} · ${checkin.customer_name}. It stays on ${checkin.site_name}’s list until the other site receives it: their gate logs it in, then a supervisor confirms it.`,
}) %>

<form method="post" action="/check-in/<%= checkin.id %>/send" class="card" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body d-grid gap-3">
    <% if (sendTo.length === 1) { %>
      <input type="hidden" name="to_site_id" value="<%= sendTo[0].id %>">
      <div><div class="form-label">Going to</div><div class="fw-semibold"><%= sendTo[0].name %></div></div>
      <% if (errors.to_site_id) { %><div class="jt-error-text"><%= errors.to_site_id %></div><% } %>
    <% } else { %>
      <%- include('partials/field', { name: 'to_site_id', label: 'Going to', type: 'select', options: sendTo.map((s) => ({ value: s.id, label: s.name })), value: values.to_site_id, error: errors.to_site_id, blank: 'Choose the site', required: true }) %>
    <% } %>
    <div class="jt-fields">
      <%- include('partials/field', { name: 'driver_name', label: 'Driver', value: values.driver_name, error: errors.driver_name, required: true, autocomplete: 'off' }) %>
      <%- include('partials/field', { name: 'driver_phone', label: 'Driver’s phone', type: 'tel', value: values.driver_phone, error: errors.driver_phone, placeholder: '0712 345 678' }) %>
      <%- include('partials/field', { name: 'people', label: 'People in the vehicle', value: values.people ?? '1', error: errors.people, inputmode: 'numeric', hint: 'Driver included' }) %>
      <%- include('partials/field', { name: 'odometer_out', label: 'Odometer now', type: 'number', value: values.odometer_out, error: errors.odometer_out, inputmode: 'numeric', hint: 'Optional, km' }) %>
      <%- include('partials/field', { name: 'notes', label: 'Notes', value: values.notes, error: errors.notes, hint: 'Optional, e.g. why it is moving' }) %>
    </div>
  </div>
  <div class="card-footer d-flex gap-2 justify-content-end">
    <a class="btn btn-outline-secondary" href="/check-in/<%= checkin.id %>">Cancel</a>
    <button class="btn btn-primary" type="submit"><i class="bi bi-send"></i>Send it</button>
  </div>
</form>
