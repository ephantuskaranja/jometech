<%#
  One page for Sales, Stock value, Purchases and Labour (reports/more.js): month and site to pick,
  number cards, then tables with a total row. Excel has the same tables, a sheet each.
%>
<%
  const link = (o) => `?${new URLSearchParams({ ...(report.monthly ? { month } : {}), ...(site ? { site: site.id } : {}), ...o })}`;
  const cell = (c, v) => {
    if (v === null || v === undefined || v === '') return '';
    if (c.type === 'money') return fmt.money(v);
    if (c.type === 'qty') return fmt.qty(v);
    if (c.type === 'date') return fmt.date(`${v}T12:00:00Z`);
    return v;
  };
  const right = (c) => (c.type === 'money' || c.type === 'qty' ? 'text-end jt-num' : '');
%>
<%- include('partials/page-header', {
  crumb: ['Reports', report.title],
  heading: report.title,
  sub: `${report.sub}${site ? ` · ${site.name}` : sites.length > 1 ? ' · all your sites' : ''}`,
  actions: [{ label: 'Download Excel', href: `/reports/${reportPath}.xlsx?${qs}`, icon: 'file-earmark-spreadsheet' }],
}) %>

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
  <% if (report.monthly) { %>
    <a class="btn btn-outline-secondary btn-sm" href="<%= link({ month: prev }) %>" aria-label="Previous month"><i class="bi bi-chevron-left"></i></a>
    <strong class="px-1"><%= label %></strong>
    <% if (month < thisMonth) { %><a class="btn btn-outline-secondary btn-sm" href="<%= link({ month: next }) %>" aria-label="Next month"><i class="bi bi-chevron-right"></i></a><% } %>
    <% if (month !== thisMonth) { %><a class="btn btn-link btn-sm" href="<%= link({ month: thisMonth }) %>">This month</a><% } %>
  <% } %>
  <% if (sites.length > 1) { %>
    <form method="get" class="ms-auto">
      <% if (report.monthly) { %><input type="hidden" name="month" value="<%= month %>"><% } %>
      <select class="form-select form-select-sm" name="site" aria-label="Site" onchange="this.form.submit()">
        <option value="">All my sites</option>
        <% sites.forEach((s) => { %><option value="<%= s.id %>"<%= site?.id === s.id ? ' selected' : '' %>><%= s.name %></option><% }) %>
      </select>
    </form>
  <% } %>
</div>

<div class="jt-kpis jt-kpis-money mb-4">
  <% data.kpis.forEach((k) => { %>
    <div class="card jt-kpi<%= k.tone ? ` is-${k.tone}` : '' %>">
      <span class="jt-kpi-label"><%= k.label %></span>
      <span class="jt-kpi-value"><%= k.value %></span>
      <% if (k.foot) { %><span class="jt-kpi-foot"><%= k.foot %></span><% } %>
    </div>
  <% }) %>
</div>

<% data.tables.forEach((t) => { %>
  <section class="card mb-4">
    <div class="card-header d-flex align-items-center gap-2">
      <h2 class="h6 mb-0 me-auto"><%= t.title %></h2>
      <span class="small text-body-secondary"><%= t.rows.length %> row<%= t.rows.length === 1 ? '' : 's' %></span>
    </div>
    <% if (!t.rows.length) { %>
      <div class="card-body small text-body-secondary"><%= report.monthly ? `Nothing in ${label}.` : 'Nothing in stock.' %></div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table jt-table mb-0">
          <thead><tr><% t.columns.forEach((c) => { %><th class="<%= right(c) %>"><%= c.label %></th><% }) %></tr></thead>
          <tbody>
            <% t.rows.forEach((r) => { %>
              <tr>
                <% t.columns.forEach((c) => { const v = r[c.key]; %>
                  <td class="<%= right(c) %>"><% if (c.type === 'link' && v) { %><a href="<%= v.href %>"><%= v.text %></a><% } else if (c.key === 'low' && v) { %><%- include('partials/pill', { text: v, tone: 'warn' }) %><% } else { %><%= cell(c, v) %><% } %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
          <% if (t.total) { %>
            <tfoot><tr class="fw-semibold"><% t.columns.forEach((c) => { %><td class="<%= right(c) %>"><%= cell(c, t.total[c.key]) %></td><% }) %></tr></tfoot>
          <% } %>
        </table>
      </div>
    <% } %>
  </section>
<% }) %>

<% if (data.note) { %><p class="small text-body-secondary"><%= data.note %></p><% } %>
