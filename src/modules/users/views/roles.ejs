<%# System → Roles: each role, what it is for, how much it can do, and who has it. %>
<%- include('partials/page-header', {
  crumb: ['System', 'Roles'],
  heading: 'Roles',
  sub: 'What each role can do. Give people roles on the Users page.',
}) %>

<section class="card">
  <div class="table-responsive">
    <table class="table jt-table mb-0">
      <thead><tr><th>Role</th><th class="d-none d-md-table-cell">For</th><th class="text-end">Can do</th><th class="text-end">People</th></tr></thead>
      <tbody>
        <% list.forEach((r) => { %>
          <tr>
            <td><a class="jt-row-link" href="/admin/roles/<%= r.id %>"><%= r.name %></a>
              <% if (r.all_sites) { %><span class="jt-sub">Every site</span><% } %></td>
            <td class="d-none d-md-table-cell small text-body-secondary"><%= r.description ?? '' %></td>
            <td class="text-end text-nowrap"><%= r.key === 'admin' ? 'Everything' : `${r.permission_count} of ${total}` %></td>
            <td class="text-end jt-num"><%= r.user_count %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
