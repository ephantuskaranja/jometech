<%# Materials leave the store for a job. Only what is in stock at this site can be chosen. %>
<%- include('partials/page-header', {
  crumb: [{ label: 'Issue materials', href: '/stores/issue' }, job.number],
  heading: `Issue materials to ${job.number}`,
  sub: `${job.customer_name}${job.vehicle_label ? `, ${job.vehicle_label}` : ''}. From stock at ${site.name}, at today’s average cost. Plates go out as whole sheets.`,
}) %>

<form method="post" action="/jobs/<%= job.id %>/issue" novalidate x-data="issueForm(<%= JSON.stringify({ rows, stock }) %>)">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card mb-4">
    <div class="card-body jt-fields">
      <%- include('partials/field', { name: 'issued_on', label: 'Date', type: 'date', value: values.issued_on, error: errors.issued_on, required: true }) %>
      <%- include('partials/field', { name: 'received_by', label: 'Taken by', value: values.received_by, error: errors.received_by, placeholder: 'Who collected them', hint: 'Optional.' }) %>
    </div>
  </section>

  <section class="card mb-4">
    <div class="card-header d-flex align-items-center"><h2 class="h6 mb-0 me-auto">Materials</h2><span class="small text-body-secondary" x-show="total > 0" x-cloak x-text="`KES ${money(total)}`"></span></div>
    <div class="card-body d-grid gap-3">
      <% if (errors.lines) { %><div class="jt-error-text"><%= errors.lines %></div><% } %>
      <% if (!stock.length) { %>
        <div class="jt-warn-box"><i class="bi bi-exclamation-triangle"></i><span>Nothing is in stock at <%= site.name %> yet. Receive goods, or enter opening stock, first.</span></div>
      <% } %>
      <template x-for="(row, i) in rows" :key="row.key">
        <div class="jt-po-line">
          <div>
            <label class="form-label" :for="`iss-${row.key}`" x-text="`Item ${i + 1}`"></label>
            <%# Search what is in stock here: any words of the name, in any order. %>
            <div class="jt-combo" @click.outside="row.open = false">
              <input class="form-control" :id="`iss-${row.key}`" name="line_label" autocomplete="off" x-model="row.label" placeholder="Type to search, e.g. plate 4"
                     role="combobox" aria-autocomplete="list" :aria-expanded="row.open" :aria-controls="`iss-list-${row.key}`"
                     @input="pick(row); row.open = true; row.active = 0" @focus="row.open = true; $el.scrollIntoView({ block: 'center', behavior: 'smooth' })" @keydown.down.prevent="move(row, 1)" @keydown.up.prevent="move(row, -1)"
                     @keydown.enter="enter(row, $event)" @keydown.escape="row.open = false" @keydown.tab="row.open = false">
              <ul class="jt-combo-list" :id="`iss-list-${row.key}`" role="listbox" x-show="row.open && matches(row).length" x-cloak>
                <template x-for="(s, n) in matches(row)" :key="s.id">
                  <li role="option" :aria-selected="n === row.active" :class="{ active: n === row.active }" @mousedown.prevent="choose(row, s)">
                    <span x-text="s.label"></span><span class="small text-body-secondary text-nowrap" x-text="`${s.available} ${s.unit}`"></span>
                  </li>
                </template>
              </ul>
              <div class="jt-combo-list jt-combo-none small text-body-secondary" x-show="row.open && row.label.trim() && !matches(row).length" x-cloak>Nothing in stock here matches.</div>
            </div>
            <input type="hidden" name="line_balance_id" :value="row.balance_id">
            <div class="form-text" x-show="row.label.trim() && !row.balance_id">Not in stock here.</div>
          </div>
          <button type="button" class="btn jt-icon-btn" @click="removeRow(i)" :aria-label="`Remove line ${i + 1}`"><i class="bi bi-x-lg"></i></button>
          <div class="jt-po-fields">
            <div><label class="form-label" :for="`iss-q-${row.key}`" x-text="stockOf(row) ? `Quantity (${stockOf(row).unit})` : 'Quantity'"></label><input class="form-control text-end jt-num" :id="`iss-q-${row.key}`" name="line_quantity" inputmode="decimal" data-number="decimal" x-model="row.quantity"></div>
          </div>
          <div class="jt-po-sums small text-body-secondary">
            <span x-show="stockOf(row)" x-text="stockOf(row) && `${stockOf(row).available} ${stockOf(row).unit} in stock`"></span>
            <span class="text-danger" x-show="tooMany(row)">More than is in stock</span>
            <span class="ms-auto fw-semibold text-body" x-show="cost(row)" x-text="`KES ${money(cost(row))}`"></span>
          </div>
        </div>
      </template>
      <div><button type="button" class="btn btn-outline-secondary btn-sm" @click="addRow()"><i class="bi bi-plus-lg"></i>Add another line</button></div>
    </div>
  </section>

  <section class="card mb-4">
    <div class="card-body">
      <%- include('partials/field', { name: 'notes', label: 'Notes', type: 'textarea', rows: 2, value: values.notes, error: errors.notes, hint: 'Optional.' }) %>
    </div>
  </section>

  <div class="jt-savebar">
    <span class="jt-savebar-note"><i class="bi bi-box-seam"></i>Saving takes this out of stock and charges it to the job.</span>
    <div class="jt-savebar-actions">
      <a class="btn btn-outline-secondary" href="/jobs/<%= job.id %>">Cancel</a>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i>Issue materials</button>
    </div>
  </div>
</form>
