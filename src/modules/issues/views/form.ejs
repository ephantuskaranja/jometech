<%# Materials leave the store for a job. Only what is in stock at this site can be chosen. %>
<%- include('partials/page-header', {
  crumb: [{ label: 'Issue materials', href: '/stores/issue' }, job.number],
  heading: `Issue materials to ${job.number}`,
  sub: `${job.customer_name}${job.vehicle_label ? `, ${job.vehicle_label}` : ''}. From stock at ${site.name}, at today’s average cost. Plates go out as whole sheets.`,
}) %>

<form method="post" action="/jobs/<%= job.id %>/issue" novalidate x-data="issueForm(<%= JSON.stringify({ rows, stock }) %>)">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card mb-4">
    <div class="card-body jt-fields">
      <%- include('partials/field', { name: 'issued_on', label: 'Date', type: 'date', value: values.issued_on, error: errors.issued_on, required: true }) %>
      <%- include('partials/field', { name: 'received_by', label: 'Taken by', value: values.received_by, error: errors.received_by, placeholder: 'Who collected them', hint: 'Optional.' }) %>
    </div>
  </section>

  <section class="card mb-4">
    <div class="card-header d-flex align-items-center"><h2 class="h6 mb-0 me-auto">Materials</h2><span class="small text-body-secondary" x-show="total > 0" x-cloak x-text="`KES ${money(total)}`"></span></div>
    <div class="card-body d-grid gap-3">
      <% if (errors.lines) { %><div class="jt-error-text"><%= errors.lines %></div><% } %>
      <% if (!stock.length) { %>
        <div class="jt-warn-box"><i class="bi bi-exclamation-triangle"></i><span>Nothing is in stock at <%= site.name %> yet. Receive goods, or enter opening stock, first.</span></div>
      <% } %>
      <%- include('issues/views/stock-lines') %>
    </div>
  </section>

  <%# Going out of the gate (to a customer's site, an outside fabricator): the gate checks it out. %>
  <section class="card mb-4" x-data="{ leaves: <%= values.leaves_site === '1' %> }">
    <div class="card-body d-grid gap-3">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="f-leaves_site" name="leaves_site" value="1" x-model="leaves">
        <label class="form-check-label" for="f-leaves_site"><strong>Leaves the site</strong>
          <span class="d-block small text-body-secondary">Going out of the gate, e.g. to the customer’s site or an outside fabricator. The gate checks the load and lets it out.</span></label>
      </div>
      <div x-show="leaves" x-cloak>
        <%- include('partials/field', { name: 'destination', label: 'Going to', value: values.destination, error: errors.destination, required: true, placeholder: 'e.g. Customer’s yard, Mombasa Road', attrs: 'maxlength="150"' }) %>
      </div>
    </div>
  </section>

  <section class="card mb-4">
    <div class="card-body">
      <%- include('partials/field', { name: 'notes', label: 'Notes', type: 'textarea', rows: 2, value: values.notes, error: errors.notes, hint: 'Optional.' }) %>
    </div>
  </section>

  <div class="jt-savebar">
    <span class="jt-savebar-note"><i class="bi bi-box-seam"></i>Saving takes this out of stock and charges it to the job.</span>
    <div class="jt-savebar-actions">
      <a class="btn btn-outline-secondary" href="/jobs/<%= job.id %>">Cancel</a>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i>Issue materials</button>
    </div>
  </div>
</form>
