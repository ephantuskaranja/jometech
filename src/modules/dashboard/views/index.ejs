<%# The dashboard: a section per area the person works in, each a strip of numbers that open the list behind them. %>
<div class="jt-page-header">
  <div>
    <div class="jt-crumb"><%= today %><%= site ? ` · ${site.name}` : '' %></div>
    <h1><%= greeting %></h1>
    <p class="jt-page-sub"><%= sections.length ? 'What needs doing today. Each number opens the list behind it.' : 'Your work is on the menu.' %></p>
  </div>
  <% if (actions.length) { %>
    <div class="jt-page-actions">
      <% actions.forEach((a) => { %><a class="btn <%= a.primary ? 'btn-primary' : 'btn-outline-secondary' %>" href="<%= a.href %>"><i class="bi bi-<%= a.icon %>"></i><%= a.label %></a><% }) %>
    </div>
  <% } %>
</div>

<% if (!sections.length) { %>
  <%- include('partials/empty', { icon: 'grid', heading: 'Nothing to count here yet', text: 'Use the menu to open your work.' }) %>
<% } %>
<% sections.forEach((s) => { %>
  <section class="jt-dash-section" aria-label="<%= s.title %>">
    <h2 class="jt-dash-title"><i class="bi bi-<%= s.icon %>"></i><%= s.title %></h2>
    <%- include('partials/kpis', { items: s.items }) %>
  </section>
<% }) %>
