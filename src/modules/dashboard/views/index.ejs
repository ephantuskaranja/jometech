<%# The dashboard: a section per area the person works in, each a strip of numbers that open the list behind them. %>
<div class="jt-page-header">
  <div>
    <div class="jt-crumb"><%= today %><%= site ? ` · ${site.name}` : '' %></div>
    <h1><%= greeting %></h1>
    <p class="jt-page-sub"><%= sections.length ? 'What needs doing today. Each number opens the list behind it.' : 'Your work is on the menu.' %></p>
  </div>
  <% if (actions.length) { %>
    <div class="jt-page-actions">
      <% actions.forEach((a) => { %><a class="btn <%= a.primary ? 'btn-primary' : 'btn-outline-secondary' %>" href="<%= a.href %>"><i class="bi bi-<%= a.icon %>"></i><%= a.label %></a><% }) %>
    </div>
  <% } %>
</div>

<% if (alerts.length) { %>
  <%# Needs attention: what is late or waiting, named, each a link. Only shown when there is something. %>
  <section class="card jt-alerts mb-4" aria-label="Needs attention">
    <div class="card-header d-flex align-items-center gap-2"><i class="bi bi-bell"></i><h2 class="h6 mb-0">Needs attention</h2></div>
    <div class="jt-alert-groups">
      <% alerts.forEach((a) => { %>
        <div class="jt-alert-group is-<%= a.tone %>">
          <div class="jt-alert-title"><i class="bi bi-<%= a.icon %>"></i><%= a.title %></div>
          <ul class="list-unstyled mb-0">
            <% a.rows.forEach((r) => { %>
              <li><a href="<%= r.href %>"><%= r.text %></a><span class="jt-alert-sub"><%= r.sub %></span></li>
            <% }) %>
          </ul>
          <% if (a.more) { %><a class="small" href="<%= a.more.href %>">and <%= a.more.count %> more →</a><% } %>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (!sections.length) { %>
  <%- include('partials/empty', { icon: 'grid', heading: 'Nothing to count here yet', text: 'Use the menu to open your work.' }) %>
<% } %>
<% sections.forEach((s) => { %>
  <section class="jt-dash-section" aria-label="<%= s.title %>">
    <h2 class="jt-dash-title"><i class="bi bi-<%= s.icon %>"></i><%= s.title %></h2>
    <%- include('partials/kpis', { items: s.items }) %>
    <% if (s.byPurpose?.length) { %>
      <%# Today's visitors by why they came. %>
      <p class="jt-purpose-strip"><span class="text-body-secondary">Today by purpose:</span>
        <% s.byPurpose.forEach((p) => { %><span class="jt-purpose-chip"><%= p.purpose %> <strong><%= p.n %></strong></span><% }) %>
      </p>
    <% } %>
  </section>
<% }) %>
