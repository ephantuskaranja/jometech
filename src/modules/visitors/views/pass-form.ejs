<%# Send a visitor on site to another site: a customer gate pass, like the paper one. %>
<%- include('partials/page-header', {
  crumb: [{ label: 'Visitors', href: '/visitors' }, { label: visitor.number, href: `/visitors/${visitor.id}` }, 'Gate pass'],
  heading: `Send ${visitor.name} to another site`,
  sub: 'A customer gate pass, approved by you. The gate clears them out as usual, and the other site sees them coming and signs them in from the pass.',
}) %>

<form method="post" action="/visitors/<%= visitor.id %>/send" novalidate class="card" x-data="{ purpose: <%= JSON.stringify(values.purpose ?? '') %> }">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body d-grid gap-4">
    <div class="jt-info-box"><i class="bi bi-person-badge"></i><span><%= visitor.name %><%= visitor.company ? `, ${visitor.company}` : '' %> · signed in <%= fmt.dateTime(visitor.arrived_at) %> (<%= visitor.number %>). Their phone and ID go with the pass.</span></div>

    <div class="jt-fields">
      <% if (sites.length === 1) { %>
        <input type="hidden" name="to_site_id" value="<%= sites[0].id %>">
        <div><div class="form-label">Going to</div><div class="fw-semibold"><%= sites[0].name %></div></div>
      <% } else { %>
        <%- include('partials/field', { name: 'to_site_id', label: 'Going to', type: 'select', value: values.to_site_id, error: errors.to_site_id, required: true,
              options: [{ value: '', label: 'Choose a site' }, ...sites.map((s) => ({ value: String(s.id), label: s.name }))] }) %>
      <% } %>
      <%- include('partials/field', { name: 'host', label: 'Who are they going to see?', type: 'select', searchable: true, options: hostOptions, value: hostValue, error: errors.host,
            hint: 'Staff at that site. Not on the list? Choose Reception.' }) %>
    </div>

    <div class="jt-choices-compact"><%- include('partials/choices', { name: 'purpose', label: 'Why are they going?', required: true, columns: 4, model: 'purpose',
          options: purposes.map((p) => ({ value: p, label: p })), value: values.purpose, error: errors.purpose }) %></div>
    <div x-show="purpose === 'Other'" x-cloak>
      <%- include('partials/field', { name: 'other_purpose', label: 'Reason', value: values.other_purpose, error: errors.other_purpose, placeholder: 'e.g. Technician for Cyrus’s truck' }) %>
    </div>

    <div class="jt-fields">
      <%- include('partials/field', { name: 'people', label: 'Number of people', value: values.people, error: errors.people, inputmode: 'numeric', hint: 'Including the visitor' }) %>
      <%- include('partials/field', { name: 'vehicle_reg', label: 'Vehicle', value: values.vehicle_reg, error: errors.vehicle_reg, placeholder: 'KDA 123A', hint: 'The vehicle they travel in, if any' }) %>
    </div>
    <%- include('partials/field', { name: 'notes', label: 'Notes', type: 'textarea', rows: 2, value: values.notes, error: errors.notes,
          hint: 'Optional: names of the others with them, what they are going to do' }) %>
  </div>
  <div class="card-footer d-flex gap-2 flex-wrap">
    <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-arrow-left-right"></i>Issue gate pass</button>
    <a class="btn btn-link" href="/visitors/<%= visitor.id %>">Cancel</a>
  </div>
</form>
