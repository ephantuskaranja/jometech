<%# Items: what the workshop buys and uses, by category. %>
<%
  const filters = (extra) => new URLSearchParams({ ...(q ? { q } : {}), ...(categoryId ? { category: categoryId } : {}), status, ...extra }).toString();
%>
<%- include('partials/page-header', {
  crumb: ['Stores', 'Items'],
  heading: 'Items',
  sub: 'What the workshop buys and uses. Prices exclude VAT.',
  actions: canManage ? [{ label: 'New item', href: '/items/new', icon: 'plus-lg', primary: true }] : [],
}) %>

<section class="card">
  <form class="jt-toolbar" method="get" action="/items">
    <input type="hidden" name="status" value="<%= status %>">
    <div class="jt-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input class="form-control" type="search" name="q" value="<%= q %>" placeholder="Name or code, e.g. plate 4" aria-label="Search items">
    </div>
    <select class="form-select w-auto" name="category" aria-label="Category" x-data @change="$el.form.requestSubmit()">
      <option value="">All categories</option>
      <% categories.forEach((c) => { %><option value="<%= c.id %>"<%= categoryId === c.id ? ' selected' : '' %>><%= c.name %></option><% }) %>
    </select>
    <nav class="jt-seg" aria-label="Show">
      <% [['active', 'Active'], ['inactive', 'Switched off'], ['all', 'All']].forEach(([key, label]) => { %>
        <a href="?<%= filters({ status: key }) %>" class="<%= status === key ? 'active' : '' %>"<%- status === key ? ' aria-current="true"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <span class="jt-count"><%= list.length %> <%= list.length === 1 ? 'item' : 'items' %></span>
  </form>

  <% if (list.length === 0) { %>
    <% if (q || categoryId || status !== 'active') { %>
      <%- include('partials/empty', { icon: 'search', heading: 'Nothing matches', text: 'Try fewer words, or another category.' }) %>
    <% } else { %>
      <%- include('partials/empty', { icon: 'box-seam', heading: 'No items yet', text: 'Add plates by thickness (Plate 4 mm) and everything else by what it is (U-bolt 20 mm).', action: canManage ? { label: 'New item', href: '/items/new' } : undefined }) %>
    <% } %>
  <% } else { %>
    <div class="table-responsive">
      <table class="table jt-table">
        <thead><tr><th>Item</th><th>Category</th><th class="text-end">In stock</th><th class="text-end">Price excl. VAT (KES)</th></tr></thead>
        <tbody>
          <% list.forEach((i) => { %>
            <tr>
              <td><a class="jt-row-link" href="/items/<%= i.id %>"><%= i.name %></a>
                <% if (!i.is_active) { %><%- include('partials/pill', { text: 'Switched off', tone: 'neutral' }) %><% } %>
                <span class="jt-sub font-monospace"><%= i.code %></span></td>
              <td><%= i.category %></td>
              <td class="text-end jt-num text-nowrap"><%= Number(i.on_hand_qty) > 0 ? `${i.priced_by === 'area' ? fmt.money(i.on_hand_qty) : fmt.qty(i.on_hand_qty)} ${i.unit}` : '—' %>
                <% if (i.reorder_level !== null && Number(i.on_hand_qty) <= Number(i.reorder_level)) { %><span class="d-block mt-1"><%- include('partials/pill', { text: 'Low stock', tone: 'warn' }) %></span><% } %></td>
              <td class="text-end jt-num text-nowrap">
                <% if (i.current_price === null) { %><span class="text-body-tertiary">Not set</span><% } else { %><%= fmt.money(i.current_price) %><span class="jt-sub">per <%= i.unit %></span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
