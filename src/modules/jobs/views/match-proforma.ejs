<%#
  Match a proforma the customer already accepted to this job (sheet row 58). A button that opens a short form:
  the proforma (newest first), then Match. Prices only for those who price work.
  Locals: job, matchable, canSeeProforma, small (true: a link-sized button, for the job's details).
%>
<% if (matchable.length) { %>
  <div x-data="{ open: false }" class="<%= locals.small ? '' : 'd-inline-block' %>">
    <button type="button" class="<%= locals.small ? 'btn btn-link btn-sm p-0 d-block' : 'btn btn-outline-primary btn-sm' %>" x-show="!open" @click="open = true">
      <i class="bi bi-link-45deg"></i><%= locals.small ? ' ' : '' %>Match a proforma (<%= matchable.length %>)</button>
    <form method="post" action="/jobs/<%= job.id %>/match-proforma" class="d-grid gap-2 mt-2" x-show="open" x-cloak style="max-width: 32rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('partials/field', { name: 'proforma_id', id: `match-proforma-${locals.small ? 'kv' : 'box'}`, label: 'Accepted proforma', type: 'select', required: true, blank: 'Choose the proforma',
            options: matchable.map((p) => ({ value: String(p.id), label: [p.number, fmt.date(p.proforma_date), p.first_line, p.reg_no || p.chassis_no || p.temp_tag || p.vehicle_description, canSeeProforma ? `KES ${fmt.money(p.total)}` : null].filter(Boolean).join(' · ') })),
            hint: 'The customer’s accepted proformas not on any job yet. The job’s work becomes the proforma’s lines.' }) %>
      <div class="d-flex gap-2"><button class="btn btn-primary btn-sm" type="submit">Match</button><button class="btn btn-link btn-sm" type="button" @click="open = false">Not now</button></div>
    </form>
  </div>
<% } %>
