<%#
  Open a job with no proforma, or change one. A job from a proforma keeps the customer and
  work that were agreed; its vehicle, supervisor, date and instructions can still change.
%>
<%
  const fixed = Boolean(job?.proforma_id);
  const typeLocked = Boolean(job?.steps?.some((s) => s.status !== 'pending'));
  // A job opened before a checked-in vehicle was needed (sheet row 49) may still have only a description.
  const legacy = Boolean(job) && !job.vehicle_id;
  // A stock build (sheet row 58): no customer yet, and often no vehicle either (a body or trailer built from scratch).
  const stock = Boolean(locals.stockId) && String(values.customer_id) === String(stockId);
%>
<%- include('partials/page-header', {
  crumb: [{ label: 'Jobs', href: '/jobs' }, job ? job.number : 'New'],
  heading: job ? `Edit ${job.number}` : 'New job',
  sub: fixed ? `From proforma ${job.proforma_number}: the customer and work stay as agreed.` : (job ? 'Change it until it is completed.' : stock ? 'A stock build: what is being built, and the work. It gets an SB number.' : 'For a vehicle checked in here: choose the customer, their vehicle and the work.'),
}) %>

<%# What stops the job being opened (another job running, the vehicle at another site), with what to do. Outside the form: its buttons are forms too. %>
<% if (locals.notice) { %><%- include('partials/notice', notice) %><% } %>

<form method="post" action="<%= job ? `/jobs/${job.id}` : '/jobs' %>" novalidate
      x-data="jobForm(<%= JSON.stringify({ rows, vehicles: vehicleOptions, hasCustomer: Boolean(values.customer_id) }) %>)">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card mb-4">
    <div class="card-header"><h2 class="h6 mb-0">Customer and vehicle</h2></div>
    <div class="card-body d-grid gap-3">
      <% if (fixed) { %>
        <dl class="jt-kv mb-0"><div><dt>Customer</dt><dd><%= job.customer_name %></dd></div></dl>
      <% } else if (stock && !job) { %>
        <input type="hidden" name="customer_id" value="<%= stockId %>">
        <div class="jt-info-box"><i class="bi bi-box"></i><span><strong>Stock build: no customer yet.</strong> Built for stock, to sell to whoever comes. Stores can issue materials straight away; assign the customer on the job when one buys it.
          <a class="d-block small mt-1" href="/jobs/new">A customer’s job instead</a></span></div>
      <% } else { %>
        <%- include('partials/field', { name: 'customer_id', label: 'Customer', type: 'select', url: '/api/customers', required: true,
              options: customerOption, value: values.customer_id, error: errors.customer_id, blank: 'Type a name, phone or CUS number',
              hint: 'Not found? Type the name and choose “Add new customer”.',
              attrs: 'data-tom-create="customer" @change="customerChanged($el.value)"' }) %>
        <%# Sheet row 58: a trailer, tanker or body built for stock, before anyone buys it. %>
        <% if (!job && locals.stockId && String(values.customer_id) !== String(stockId)) { %><a class="small" href="/jobs/new?customer_id=<%= stockId %>"><i class="bi bi-box"></i> No customer yet? Open it as a stock build</a><% } %>
      <% } %>
      <% if (stock && !job) { %>
        <%# Stock build: Jome-Tech builds the chassis itself. A trailer or tanker is registered as its build starts; a body only has no vehicle. %>
        <div x-data="{ kind: <%= JSON.stringify(values.build_kind || 'trailer') %> }" class="d-grid gap-3">
          <%- include('partials/choices', { name: 'build_kind', label: 'What is it?', required: true, columns: 2, model: 'kind', value: values.build_kind || 'trailer', options: [
                { value: 'trailer', label: 'A trailer or tanker', hint: 'Chassis built here. Registered from the start: a temporary tag until its chassis number is stamped' },
                { value: 'body', label: 'A body only', hint: 'To fit on a buyer’s truck. No vehicle until it is sold' }] }) %>
          <div x-show="kind === 'trailer'" x-cloak>
            <%- include('partials/choices', { name: 'trailer_type', label: 'Registered as', columns: 2, value: values.trailer_type || 'trailer', options: [
                  { value: 'trailer', label: 'Trailer', hint: 'Full trailer, on its own axles front and back' },
                  { value: 'semi_trailer', label: 'Semi-trailer', hint: 'Rests on the prime mover’s fifth wheel (most tankers)' }] }) %>
          </div>
          <%- include('partials/field', { name: 'vehicle_description', label: 'What is being built', value: values.vehicle_description, error: errors.vehicle_description, required: true,
                placeholder: 'e.g. 40ft fuel tanker, 3 axle; skeletal trailer; 20ft cargo body', hint: 'Shown on the job, the job card and Reports → Stock value.' }) %>
        </div>
      <% } else { %>
      <div class="jt-fields">
        <div x-show="hasCustomer" x-cloak>
          <div class="jt-field">
            <label class="form-label" for="f-vehicle_id"><%= stock ? 'Chassis checked in here (optional)' : 'Their vehicle, checked in here' %></label>
            <select class="form-select<%= errors.vehicle_id ? ' is-invalid' : '' %>" id="f-vehicle_id" name="vehicle_id">
              <option value=""><%= stock ? 'None: built from scratch' : legacy ? 'Not here yet' : 'Choose the vehicle' %></option>
              <template x-for="v in vehicles" :key="v.value"><option :value="v.value" x-text="v.label" :disabled="v.disabled" :selected="String(v.value) === <%= JSON.stringify(String(values.vehicle_id ?? '')) %>"></option></template>
            </select>
            <% if (errors.vehicle_id) { %><div class="invalid-feedback d-block"><%= errors.vehicle_id %></div><% } %>
            <% if (stock) { %><div class="form-text">A stock trailer’s own record; a body only has none until it is fitted to a buyer’s truck.</div><% } else { %>
            <div class="form-text" x-show="!vehicles.some((v) => !v.disabled)">None of their vehicles is checked in here. The gate logs it in, then it is checked in<% if (canCheckIn) { %> under <a href="/check-in">Check-in</a><% } %>; then open its job.</div><% } %>
          </div>
        </div>
        <% if (legacy) { %>
          <%- include('partials/field', { name: 'vehicle_description', label: 'Vehicle (if not registered)', value: values.vehicle_description, error: errors.vehicle_description, placeholder: 'e.g. Sinotruck Howo H3 6 wheeler' }) %>
        <% } %>
      </div>
      <% } %>
    </div>
  </section>

  <section class="card mb-4">
    <div class="card-header"><h2 class="h6 mb-0">Work to be done</h2></div>
    <div class="card-body d-grid gap-3">
      <% if (fixed) { %>
        <ul class="mb-0 ps-3">
          <% job.lines.forEach((l) => { %><li style="white-space: pre-line"><%= fmt.qty(l.quantity) %> <%= l.unit %>: <%= l.description %></li><% }) %>
        </ul>
      <% } else { %>
        <% if (errors.lines) { %><div class="jt-error-text"><%= errors.lines %></div><% } %>
        <div class="jt-lines jt-lines-job">
          <div class="jt-lines-head" aria-hidden="true"><span>Qty</span><span>Unit</span><span>Description</span><span></span></div>
          <template x-for="(row, i) in rows" :key="row.key">
            <div class="jt-lines-row">
              <label class="jt-lines-label">Qty</label>
              <input class="form-control text-end jt-num" type="text" inputmode="decimal" data-number="decimal" name="line_quantity" x-model="row.quantity" :aria-label="`Quantity, line ${i + 1}`">
              <label class="jt-lines-label">Unit</label>
              <input class="form-control" type="text" name="line_unit" x-model="row.unit" maxlength="20" list="line-units" :aria-label="`Unit, line ${i + 1}`">
              <label class="jt-lines-label">Description</label>
              <textarea class="form-control" name="line_description" x-model="row.description" rows="3" :aria-label="`Description, line ${i + 1}`"
                        placeholder="Repair cracked tipper floor&#10;- Replace rear hinge&#10;- Repaint the patch"></textarea>
              <button type="button" class="btn jt-icon-btn" @click="removeRow(i)" :aria-label="`Remove line ${i + 1}`"><i class="bi bi-x-lg"></i></button>
            </div>
          </template>
        </div>
        <datalist id="line-units"><option value="Unit"><option value="Pc"><option value="Set"><option value="Lot"><option value="Day"></datalist>
        <div class="d-flex flex-wrap align-items-start gap-3">
          <button type="button" class="btn btn-outline-secondary btn-sm" @click="addRow()"><i class="bi bi-plus-lg"></i>Add another line</button>
          <span class="form-text mt-0">Start a line with “- ” to print it as a bullet point.</span>
        </div>
      <% } %>
    </div>
  </section>

  <section class="card mb-4">
    <div class="card-header"><h2 class="h6 mb-0">For the workshop</h2></div>
    <div class="card-body d-grid gap-3">
      <% if (typeLocked) { %>
        <dl class="jt-kv mb-0"><div><dt>Job type</dt><dd><%= job.job_type_name %></dd></div></dl>
        <% if (errors.job_type_id) { %><div class="jt-error-text"><%= errors.job_type_id %></div><% } %>
      <% } else { %>
        <%- include('partials/field', { name: 'job_type_id', label: 'Job type', type: 'select', options: jobTypes, value: values.job_type_id, error: errors.job_type_id, blank: job && !job.job_type_id ? 'No steps' : undefined,
              hint: 'Sets the production steps. It can change until the first step is ticked off.' }) %>
      <% } %>
      <div class="jt-fields">
        <div>
          <% if (supervisorLocked) { %>
            <dl class="jt-kv mb-0"><div><dt>Supervisor</dt><dd><%= job.supervisor_name %><span class="d-block small text-body-secondary">Only a manager or admin can change it now.</span></dd></div></dl>
          <% } else { %>
          <%- include('partials/field', { name: 'supervisor_id', label: 'Supervisor', type: 'select', options: supervisors, value: values.supervisor_id, error: errors.supervisor_id,
                blank: 'Not decided yet', searchable: true }) %>
          <% } %>
          <% if (supervisorHelp) { %>
            <div class="form-text">No supervisors at <%= supervisorHelp.site %> yet.<% if (supervisorHelp.canAdd) { %> <a href="/admin/users/new">Add one under Users</a> (role: Supervisor).<% } %></div>
          <% } %>
        </div>
        <%- include('partials/field', { name: 'responsible_name', label: 'Responsible employee', value: values.responsible_name, error: errors.responsible_name,
              placeholder: 'e.g. Otieno (welding foreman)', hint: 'Optional. Someone who doesn’t use the app, e.g. the foreman doing the work.' }) %>
        <%- include('partials/field', { name: 'due_on', label: 'Promised by', type: 'date', value: values.due_on, error: errors.due_on, hint: 'Optional. The date the customer expects it.',
          attrs: `min="${job?.due_on && job.due_on < today ? job.due_on : today}"` }) %>
      </div>
      <%- include('partials/field', { name: 'instructions', label: 'Instructions', type: 'textarea', rows: 3, value: values.instructions, error: errors.instructions,
            hint: 'Optional. Printed on the job card.', placeholder: 'e.g. Customer supplies the paint. Call before fitting the toolbox.' }) %>
    </div>
  </section>

  <div class="jt-savebar">
    <span class="jt-savebar-note"><i class="bi bi-wrench-adjustable"></i>You can print the job card once it is saved.</span>
    <div class="jt-savebar-actions">
      <a class="btn btn-outline-secondary" href="<%= job ? `/jobs/${job.id}` : '/jobs' %>">Cancel</a>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i><%= job ? 'Save changes' : 'Open the job' %></button>
    </div>
  </div>
</form>

<% if (!fixed) { %><%- include('customers/views/quick-add') %><% } %>
