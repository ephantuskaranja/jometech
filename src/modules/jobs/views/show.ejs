<%# One job: the work to be done, who it is for, and what happens next. No prices here: the proforma keeps those. %>
<%
  const st = statuses[job.status];
  const active = ['open', 'in_progress'].includes(job.status);
  const late = active && job.due_on && job.due_on < today;
  const promised = job.due_on ? fmt.date(`${job.due_on}T12:00:00Z`) : null;
  const details = [job.make, job.model].filter(Boolean).join(' ');
  const current = job.currentStep;
  // The next step still to do (after rework, the steps in between may already be done).
  const nextStep = current ? job.steps.slice(job.steps.findIndex((s) => s.id === current.id) + 1).find((s) => s.status === 'pending') : null;
  const percent = job.steps.length ? Math.round((job.stepsFinished / job.steps.length) * 100) : 0;
%>
<section class="card mb-4">
  <div class="card-body jt-record">
    <div class="jt-crumb">Workshop <i class="bi bi-chevron-right"></i><a href="/jobs">Jobs</a><i class="bi bi-chevron-right"></i><span><%= job.number %></span></div>
    <div class="jt-record-top">
      <% if (job.reg_no) { %><%- include('partials/plate', { reg: job.reg_no, size: 'lg' }) %><% } %>
      <div class="jt-record-title">
        <h1 class="h3"><%= job.number %> <%- include('partials/pill', { text: st.label, tone: st.tone }) %><% if (late) { %> <%- include('partials/pill', { text: 'Late', tone: 'warn' }) %><% } %></h1>
        <div class="jt-meta">
          <span><i class="bi bi-person"></i><%= job.customer_name %></span>
          <span><i class="bi bi-geo-alt"></i><%= job.site_name %></span>
          <% if (promised) { %><span><i class="bi bi-calendar-check"></i>Promised <%= promised %></span><% } %>
        </div>
      </div>
      <div class="jt-page-actions">
        <% if (canManage && active) { %><a class="btn btn-outline-secondary" href="/jobs/<%= job.id %>/edit"><i class="bi bi-pencil"></i>Edit</a><% } %>
        <a class="btn btn-primary" href="/jobs/<%= job.id %>/print"><i class="bi bi-printer"></i>Job card</a>
      </div>
    </div>
  </div>
</section>

<%
  // The same main button as the "Next step" card, at the top on phones and tablets (where that card
  // is far down the page, under the steps). Big screens show the card beside the steps instead.
  const openQc = qcChecks.find((q) => q.status === 'in_progress');
  // Vehicle Received waits for the vehicle's check-in (or, with no vehicle at all, may be skipped).
  const noVehicle = !job.vehicle_id && !job.vehicle_description;
  const waitVehicle = job.status === 'in_progress' && current?.is_receive ? {
    tone: 'warning',
    text: job.vehicle_id ? `Waiting for ${job.vehicle_label} to be checked in. ${current.name} is ticked off by its check-in.`
      : job.vehicle_description ? `Waiting for the vehicle (${job.vehicle_description}). Once it is checked in, choose it on the job.`
      : 'This job has no vehicle. Skip this step if none is coming.',
    actions: [
      ...(job.vehicle_id && canCheckIn ? [{ label: 'Check the vehicle in', href: `/check-in/new?vehicle_id=${job.vehicle_id}`, icon: 'truck', primary: true }] : []),
      ...(!job.vehicle_id && job.vehicle_description && canManage ? [{ label: 'Choose the vehicle', href: `/jobs/${job.id}/edit`, icon: 'pencil', primary: true }] : []),
      ...(noVehicle && canManage ? [{ label: 'Skip: no vehicle', post: `/jobs/${job.id}/steps/${current.id}/skip`, icon: 'dash-circle', primary: true }] : []),
    ],
  } : null;
  let top = null;
  if (job.status === 'open' && canManage) {
    top = { tone: 'info', text: 'Print the job card, then start the job when work begins.', actions: [
      { label: 'Start the job', post: `/jobs/${job.id}/start`, icon: 'play-fill', primary: true },
      { label: 'Job card', href: `/jobs/${job.id}/print`, icon: 'printer' }] };
  } else if (waitVehicle) {
    top = waitVehicle;
  } else if (job.status === 'in_progress' && current?.is_qc) {
    top = { tone: 'warning', text: `Now: ${current.name}.`, actions: canInspect
      ? [openQc ? { label: `Carry on with ${openQc.number}`, href: `/qc/${openQc.id}`, icon: 'clipboard-check', primary: true } : { label: 'Start quality check', post: `/jobs/${job.id}/qc`, icon: 'clipboard-check', primary: true }]
      : [] };
    if (!canInspect) top.text += ' Someone who does quality checks takes it from here.';
  } else if (job.status === 'in_progress' && current?.is_signoff && canManage) {
    top = { tone: 'warning', text: `Now: ${current.name}. The customer checks the work and signs.`, actions: [{ label: 'Customer sign-off', href: `/jobs/${job.id}/signoff`, icon: 'pen', primary: true }] };
  } else if (job.status === 'in_progress' && current && canManage) {
    top = { tone: 'info', text: `Now: ${current.name} (${job.stepsFinished + 1} of ${job.steps.length}).`, actions: [
      { label: `${current.name} done`, post: `/jobs/${job.id}/steps/${current.id}/done`, icon: 'check2', primary: true }] };
  } else if (job.status === 'in_progress' && !current && canManage) {
    top = { tone: 'success', text: 'All steps done.', actions: [{ label: 'Mark completed', post: `/jobs/${job.id}/complete`, icon: 'check2-circle', primary: true }] };
  } else if (job.status === 'completed' && afterDone.length) {
    top = { tone: 'success', text: 'Work completed. Next: invoice, payment and release.', actions: afterDone };
  }
%>
<% if (top) { %><div class="d-lg-none"><%- include('partials/next-step', top) %></div><% } %>

<div class="row g-4">
  <div class="col-lg-8 d-grid gap-4 align-content-start">
    <% if (job.steps.length) { %>
      <section class="card">
        <div class="card-header d-flex align-items-center gap-3">
          <h2 class="h6 mb-0 me-auto">Production steps</h2>
          <span class="small text-body-secondary text-nowrap"><%= job.stepsFinished %> of <%= job.steps.length %></span>
        </div>
        <div class="progress rounded-0" style="height: .375rem" role="progressbar" aria-label="Steps finished" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-success" style="width: <%= percent %>%"></div></div>
        <ol class="jt-job-steps list-group list-group-flush">
          <% job.steps.forEach((s) => { const isCurrent = current?.id === s.id; %>
            <li class="list-group-item is-<%= isCurrent ? 'current' : s.status %>">
              <i class="bi bi-<%= isCurrent ? 'arrow-right-circle-fill' : { done: 'check-circle-fill', skipped: 'dash-circle', pending: 'circle' }[s.status] %>" aria-hidden="true"></i>
              <span class="jt-job-step-name"><%= s.name %><% if (s.is_receive) { %> <i class="bi bi-truck text-body-tertiary" title="Ticked off by the vehicle’s check-in"></i><% } %><% if (s.is_qc) { %> <i class="bi bi-shield-check text-body-tertiary" title="Ticked off by a passed quality check"></i><% } %><% if (s.is_signoff) { %> <i class="bi bi-pen text-body-tertiary" title="Ticked off by the customer’s sign-off"></i><% } %><% if (isCurrent) { %> <span class="visually-hidden">(current step)</span><% } %>
                <% if (s.rework_signoff_id && s.status === 'pending') { %>
                  <span class="d-block small mt-1"><span class="badge text-bg-danger">Rework</span> customer’s concerns</span>
                  <ul class="jt-rework-list small mb-0"><li><% if (s.rework_signer_name) { %><span class="text-body-secondary"><%= s.rework_signer_name %>:</span> <% } %><%= s.rework_concerns %></li></ul>
                <% } %>
                <% if (s.rework) { %>
                  <span class="d-block small mt-1"><span class="badge text-bg-danger">Rework</span> from <a href="/qc/<%= s.rework_qc_id %>"><%= s.rework_qc_number %></a></span>
                  <ul class="jt-rework-list small mb-0">
                    <% s.rework.forEach((i) => { %><li><%= i.text %><% if (i.note) { %>: <span class="text-body-secondary"><%= i.note %></span><% } %></li><% }) %>
                  </ul>
                <% } %></span>
              <% if (s.status !== 'pending') { %>
                <span class="small text-body-tertiary text-end"><%= s.status === 'skipped' ? 'Skipped' : 'Done' %> <%= fmt.dateTime(s.finished_at) %><% if (s.finished_by_name) { %><span class="d-block"><%= s.finished_by_name %></span><% } %></span>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </section>
    <% } %>

    <% if (qcChecks.length || signoffs.length) { %>
      <section class="card">
        <div class="card-header"><h2 class="h6 mb-0">Quality checks<%= signoffs.length ? ' and sign-off' : '' %></h2></div>
        <ul class="list-group list-group-flush">
          <% signoffs.forEach((so) => { const o = signoffOutcomes[so.outcome]; %>
            <li class="list-group-item d-flex flex-wrap gap-2 align-items-center">
              <span class="me-2"><i class="bi bi-pen"></i> Customer</span>
              <%- include('partials/pill', { text: o.label, tone: o.tone }) %>
              <span class="small text-body-secondary me-auto">
                <% if (so.outcome === 'not_signed') { %><%= so.reason %><% } else { %><%= so.signer_name %><%= so.signer_role === 'driver' ? ' (driver)' : '' %><% if (so.outcome === 'concerns') { %>: <%= so.concerns %><% } %><% } %>
              </span>
              <% if (so.signature_path) { %><a href="/signoffs/<%= so.id %>/signature.png" target="_blank" rel="noopener"><img class="jt-signoff-sig" src="/signoffs/<%= so.id %>/signature.png" alt="Signature of <%= so.signer_name %>" height="32"></a><% } %>
              <span class="small text-body-tertiary"><%= [so.recorded_by_name, fmt.dateTime(so.created_at)].filter(Boolean).join(', ') %></span>
            </li>
          <% }) %>
          <% qcChecks.forEach((q) => { %>
            <li class="list-group-item d-flex flex-wrap gap-2 align-items-center">
              <a class="font-monospace me-2" href="/qc/<%= q.id %>"><%= q.number %></a>
              <%- include('partials/pill', { text: qcStatuses[q.status].label, tone: qcStatuses[q.status].tone }) %>
              <span class="small text-body-secondary me-auto">Attempt <%= q.attempt %><%= Number(q.failed) ? ` · ${q.failed} failed` : '' %></span>
              <span class="small text-body-tertiary"><%= [q.finished_by_name ?? q.started_by_name, fmt.dateTime(q.finished_at ?? q.started_at)].filter(Boolean).join(', ') %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Work to be done</h2></div>
      <div class="table-responsive">
        <table class="table jt-table mb-0">
          <thead><tr><th>Qty</th><th>Description</th></tr></thead>
          <tbody>
            <% job.lines.forEach((l) => { %>
              <tr>
                <td class="text-nowrap"><%= fmt.qty(l.quantity) %> <%= l.unit %></td>
                <td>
                  <% String(l.description).split('\n').forEach((text) => { const bullet = /^\s*[-•*]\s+/.test(text); %>
                    <div class="<%= bullet ? 'jt-bullet' : '' %>"><%= bullet ? text.replace(/^\s*[-•*]\s+/, '') : text %></div>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
            <% if (!job.lines.length) { %><tr><td colspan="2" class="text-body-secondary small">No work listed.</td></tr><% } %>
          </tbody>
        </table>
      </div>
      <% if (job.instructions) { %>
        <div class="card-body border-top">
          <div class="small fw-semibold mb-1">Instructions</div>
          <p class="mb-0" style="white-space: pre-line"><%= job.instructions %></p>
        </div>
      <% } %>
    </section>

    <%- include('variations') %>

    <%- include('photos') %>

    <% const waitingForPrice = active && !materialsOk; %>
    <% if (materials.lines.length || canIssue || waitingForPrice) { %>
      <section class="card">
        <div class="card-header d-flex align-items-center gap-3">
          <h2 class="h6 mb-0 me-auto">Materials</h2>
          <% if (canSeeCost && materials.lines.length) { %><span class="small jt-num fw-semibold text-nowrap">KES <%= fmt.money(materials.total) %></span><% } %>
          <% if (canIssue && materialsOk) { %><a class="btn btn-outline-secondary btn-sm text-nowrap" href="/jobs/<%= job.id %>/issue"><i class="bi bi-box-seam"></i>Issue materials</a><% } %>
        </div>
        <%# Stores wait for the customer's yes on a proforma, or a supervisor's go-ahead (sheet row 49). %>
        <% if (waitingForPrice) { %>
          <div class="card-body border-bottom" x-data="{ allow: false }">
            <p class="small mb-2"><i class="bi bi-hourglass-split text-warning"></i> Stores can’t issue materials yet: the customer hasn’t accepted a proforma for this job.
              <% if (job.pending_proforma) { %>
                <% if (canSeeProforma) { %><a class="font-monospace" href="/proformas/<%= job.pending_proforma.id %>"><%= job.pending_proforma.number %></a><% } else { %><span class="font-monospace"><%= job.pending_proforma.number %></span><% } %>
                <%= job.pending_proforma.status === 'draft' ? 'is still a draft.' : 'is with the customer.' %>
              <% } else { %>No proforma has been made for it yet.<% } %>
            </p>
            <div class="d-flex flex-wrap gap-2" x-show="!allow">
              <%- include('match-proforma', { job, matchable, canSeeProforma }) %>
              <% if (canMakeProforma) { %><a class="btn btn-primary btn-sm" href="/proformas/new?job=<%= job.id %>"><i class="bi bi-receipt"></i>Make proforma</a><% } %>
              <% if (canAllowMaterials) { %><button type="button" class="btn btn-outline-secondary btn-sm" @click="allow = true; $nextTick(() => $refs.why.focus())"><i class="bi bi-unlock"></i>Allow materials now</button><% } %>
            </div>
            <% if (canAllowMaterials) { %>
              <form method="post" action="/jobs/<%= job.id %>/allow-materials" class="d-grid gap-2" x-show="allow" x-cloak>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <%- include('partials/field', { name: 'reason', id: 'allow-reason', label: 'Why can stores issue before the proforma is accepted?', placeholder: 'e.g. Fleet customer on account; LPO on the way', required: true, attrs: 'x-ref="why" maxlength="255"' }) %>
                <div class="d-flex gap-2"><button class="btn btn-primary btn-sm" type="submit">Allow materials</button><button class="btn btn-link btn-sm" type="button" @click="allow = false">Not now</button></div>
              </form>
            <% } %>
          </div>
        <% } else if (!job.proforma_id && job.materials_allowed_by) { %>
          <div class="card-body border-bottom small text-body-secondary"><%= job.stock_build && job.customer_is_stock ? 'Stock build: stores issue materials to it without a proforma.' : `Allowed before a proforma was accepted, by ${job.materials_allowed_name ?? 'a supervisor'}: ${job.materials_allowed_reason}` %></div>
        <% } %>
        <% if (waitingForPrice && !materials.lines.length) { %>
        <% } else if (!materials.lines.length) { %>
          <div class="card-body small text-body-secondary">Nothing issued to this job yet.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table jt-table mb-0">
              <thead><tr><th>Item</th><th>Issue</th><th class="text-end">Used</th><% if (canSeeCost) { %><th class="text-end">Cost (KES)</th><% } %></tr></thead>
              <tbody>
                <% materials.lines.forEach((l) => { const used = Number(l.quantity) - Number(l.returned_qty); %>
                  <tr>
                    <td><%= l.item_name %><% if (l.size_unit) { %><span class="jt-sub"><%= Number(l.length) %> × <%= Number(l.width) %> <%= l.size_unit %></span><% } %></td>
                    <td class="text-nowrap"><% if (canOpenIssues) { %><a class="font-monospace small" href="/stores/issue/<%= l.issue_id %>"><%= l.issue_number %></a><% } else { %><span class="font-monospace small"><%= l.issue_number %></span><% } %><span class="jt-sub"><%= fmt.date(`${l.issued_on}T12:00:00Z`) %></span></td>
                    <td class="text-end text-nowrap"><%= fmt.qty(used) %> <%= l.priced_by === 'area' ? 'pcs' : l.item_unit %><% if (Number(l.returned_qty) > 0) { %><span class="jt-sub"><%= fmt.qty(l.returned_qty) %> returned</span><% } %></td>
                    <% if (canSeeCost) { %><td class="text-end jt-num"><%= fmt.money(Number(l.value) - Number(l.returned_value)) %></td><% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">History</h2></div>
      <div class="card-body"><%- include('partials/history', { entries, labels: { job_type: 'Job type', customer: 'Customer', vehicle: 'Vehicle', supervisor: 'Supervisor', responsible: 'Responsible', due_on: 'Promised by', instructions: 'Instructions', work: 'Work' } }) %></div>
    </section>
  </div>

  <div class="col-lg-4 d-grid gap-4 align-content-start">
    <section class="card" x-data="{ step: '' }">
      <div class="card-header"><h2 class="h6 mb-0">Next step</h2></div>
      <div class="card-body d-grid gap-3">
        <% if (job.status === 'open') { %>
          <p class="small mb-0">Print the job card for the workshop, then start the job when work begins.</p>
        <% } else if (job.status === 'in_progress') { %>
          <p class="small mb-0">Started <%= fmt.dateTime(job.started_at) %>.<%= current ? '' : ' Mark it completed when the work is done.' %></p>
        <% } else if (job.status === 'completed') { %>
          <p class="small mb-0">Completed <%= fmt.dateTime(job.completed_at) %>.<%= afterDone.length ? ' Next: invoice, payment and release.' : '' %></p>
          <% afterDone.forEach((a) => { %>
            <a class="btn <%= a.primary ? 'btn-primary' : 'btn-outline-secondary' %> w-100" href="<%= a.href %>"><i class="bi bi-<%= a.icon %>"></i><%= a.label %></a>
          <% }) %>
        <% } else { %>
          <div class="small">Cancelled <%= fmt.dateTime(job.cancelled_at) %><div class="mt-1"><%= job.cancelled_reason %></div></div>
        <% } %>

        <% if (canManage) { %>
          <% if (job.status === 'open') { %>
            <form method="post" action="/jobs/<%= job.id %>/start" x-show="!step">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-primary w-100" type="submit"><i class="bi bi-play-fill"></i>Start the job</button>
            </form>
          <% } else if (waitVehicle) { %>
            <%# Vehicle Received: ticked off only by the vehicle's check-in. %>
            <div class="d-grid gap-2" x-show="!step">
              <p class="small mb-0"><i class="bi bi-truck"></i> <%= waitVehicle.text %></p>
              <% waitVehicle.actions.forEach((a) => { %>
                <% if (a.post) { %>
                  <form method="post" action="<%= a.post %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-<%= a.icon %>"></i><%= a.label %></button>
                  </form>
                <% } else { %>
                  <a class="btn btn-primary btn-lg w-100" href="<%= a.href %>"><i class="bi bi-<%= a.icon %>"></i><%= a.label %></a>
                <% } %>
              <% }) %>
            </div>
          <% } else if (current?.is_qc) { %>
            <%# The quality check step: ticked off only by a passed check. %>
            <% const openCheck = qcChecks.find((q) => q.status === 'in_progress'); %>
            <div class="d-grid gap-2" x-show="!step">
              <% if (!canInspect) { %>
                <p class="small mb-0"><i class="bi bi-shield-check"></i> Waiting for a quality check by a supervisor.</p>
              <% } else if (openCheck) { %>
                <a class="btn btn-primary btn-lg w-100" href="/qc/<%= openCheck.id %>"><i class="bi bi-clipboard-check"></i>Carry on with <%= openCheck.number %></a>
              <% } else { %>
                <form method="post" action="/jobs/<%= job.id %>/qc">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-clipboard-check"></i>Start quality check</button>
                </form>
              <% } %>
              <div class="d-flex flex-wrap gap-3 small">
                <a class="btn btn-link btn-sm p-0 text-body-secondary" href="/qc-form/print?job=<%= job.id %>">Print the blank form</a>
                <% if (job.stepsFinished) { %>
                  <form method="post" action="/jobs/<%= job.id %>/steps/undo">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-link btn-sm p-0 text-body-secondary" type="submit">Undo the last step</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } else if (current?.is_signoff) { %>
            <%# The customer's sign-off step: ticked off only by a sign-off (or no one there to sign). %>
            <div class="d-grid gap-2" x-show="!step">
              <a class="btn btn-primary btn-lg w-100" href="/jobs/<%= job.id %>/signoff"><i class="bi bi-pen"></i>Customer sign-off</a>
              <% if (job.stepsFinished) { %>
                <form method="post" action="/jobs/<%= job.id %>/steps/undo" class="small">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-link btn-sm p-0 text-body-secondary" type="submit">Undo the last step</button>
                </form>
              <% } %>
            </div>
          <% } else if (current) { %>
            <div class="d-grid gap-2" x-show="!step">
              <form method="post" action="/jobs/<%= job.id %>/steps/<%= current.id %>/done">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-success btn-lg w-100" type="submit"><i class="bi bi-check2"></i><%= current.name %> done → <%= nextStep?.name ?? 'Job completed' %></button>
              </form>
              <div class="d-flex flex-wrap gap-3 small">
                <form method="post" action="/jobs/<%= job.id %>/steps/<%= current.id %>/skip">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-link btn-sm p-0 text-body-secondary" type="submit">Skip: doesn’t apply to this job</button>
                </form>
                <% if (job.stepsFinished) { %>
                  <form method="post" action="/jobs/<%= job.id %>/steps/undo">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-link btn-sm p-0 text-body-secondary" type="submit">Undo the last step</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } else if (job.status === 'in_progress') { %>
            <form method="post" action="/jobs/<%= job.id %>/complete" x-show="!step">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-success w-100" type="submit"><i class="bi bi-check2-circle"></i>Mark completed</button>
            </form>
          <% } else { %>
            <form method="post" action="/jobs/<%= job.id %>/reopen">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-outline-primary w-100" type="submit"><i class="bi bi-arrow-counterclockwise"></i>Reopen</button>
            </form>
          <% } %>

          <% if (active) { %>
            <button type="button" class="btn btn-link btn-sm p-0 text-body-secondary text-start" x-show="!step" @click="step = 'cancel'">Cancel this job</button>
            <div x-show="step === 'cancel'" x-cloak>
              <form method="post" action="/jobs/<%= job.id %>/cancel" class="d-grid gap-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <%- include('partials/field', { name: 'reason', label: 'Why is it being cancelled?', placeholder: 'e.g. Customer changed their mind', required: true }) %>
                <div class="d-flex gap-2"><button class="btn btn-secondary" type="submit">Cancel the job</button><button class="btn btn-link" type="button" @click="step = ''">Keep it</button></div>
              </form>
            </div>
          <% } %>
        <% } %>
      </div>
    </section>

    <% if (costing) {
         const c = costing;
         const loss = c.net !== null && c.net < 0;
         const monthName = (m) => new Date(`${m}-15T12:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
         const weeks = (n) => `${n} week${n === 1 ? '' : 's'}`; %>
      <section class="card">
        <div class="card-header d-flex align-items-center gap-2">
          <h2 class="h6 mb-0 me-auto">Job costing</h2>
          <% if (c.netMargin !== null) { %><%- include('partials/pill', { text: `${c.netMargin}% margin`, tone: loss ? 'bad' : c.netMargin < 15 ? 'warn' : 'ok' }) %><% } %>
        </div>
        <div class="card-body">
          <dl class="jt-costing mb-0">
            <div><dt>Price, without VAT</dt>
              <dd class="jt-num"><%= c.price ? `KES ${fmt.money(c.price.exVat)}` : '—' %></dd>
              <% if (c.price) { %><dd class="jt-costing-note">From <%= c.price.against %>: KES <%= fmt.money(c.price.total) %> with VAT</dd><% } else { %><dd class="jt-costing-note">No price yet: make the invoice, or start the job from a proforma.</dd><% } %>
            </div>
            <div><dt>Materials</dt><dd class="jt-num">− KES <%= fmt.money(c.materials) %></dd><dd class="jt-costing-note">Issued less returns, at cost (transport included)</dd></div>
            <div class="jt-costing-sub"><dt>Gross profit</dt><dd class="jt-num"><%= c.gross === null ? '—' : `KES ${fmt.money(c.gross)}` %><%= c.margin !== null ? ` · ${c.margin}%` : '' %></dd></div>
            <% if (c.wages) { %>
              <div><dt>Wages, its share</dt><dd class="jt-num">− KES <%= fmt.money(c.wages.amount) %></dd>
                <dd class="jt-costing-note">Approved weekly payroll at <%= job.site_name %>, shared by work days<% if (c.wages.missing.length) { %>. <span class="text-warning-emphasis">No approved payroll yet for <%= weeks(c.wages.missing.length) %></span><% } %></dd></div>
              <div><dt>Running costs, its share</dt><dd class="jt-num">− KES <%= fmt.money(c.running.amount) %></dd>
                <dd class="jt-costing-note">Power, rent and other bills at <%= job.site_name %>, shared by work days<% if (c.running.missing.length) { %>. <a class="text-warning-emphasis" href="/costing/running-costs?month=<%= c.running.missing[0] %>">Not entered for <%= c.running.missing.map(monthName).join(', ') %></a><% } %></dd></div>
            <% } %>
            <div class="jt-costing-total<%= loss ? ' is-loss' : '' %>"><dt><%= loss ? 'Loss' : 'Net profit' %></dt><dd class="jt-num"><%= c.net === null ? '—' : `KES ${fmt.money(Math.abs(c.net))}` %></dd></div>
          </dl>
          <div class="small text-body-secondary mt-3">
            <i class="bi bi-calendar3"></i>
            <% if (c.days) { %>
              <strong class="text-body"><%= c.days.days %> work day<%= c.days.days === 1 ? '' : 's' %></strong><%= c.days.open ? ' so far' : '' %>,
              <%= fmt.date(`${c.days.from}T12:00:00Z`) %> to <%= c.days.open ? 'today' : fmt.date(`${c.days.to}T12:00:00Z`) %>. Sundays and closed days are left out.
            <% } else { %>Work days, wages and running costs start counting when the job is started.<% } %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (money) { const inv = money.invoice; %>
      <section class="card">
        <div class="card-header"><h2 class="h6 mb-0">Invoice</h2></div>
        <div class="card-body d-grid gap-2">
          <% if (inv) { %>
            <div class="d-flex align-items-center gap-2">
              <a href="/invoices/<%= inv.id %>"><%= inv.number ? `Invoice ${inv.number}` : 'Draft invoice' %></a>
              <span class="ms-auto jt-num small">KES <%= fmt.money(inv.total) %></span>
            </div>
            <% if (inv.status === 'issued') { %><div class="small text-body-secondary"><%= money.balance > 0 ? `KES ${fmt.money(money.balance)} still to pay` : money.balance < 0 ? `Fully paid · KES ${fmt.money(-money.balance)} held as the customer’s credit` : 'Fully paid' %></div><% } %>
          <% } else if (job.status !== 'cancelled') { %>
            <p class="small mb-0"><%= job.proforma_id ? `Made from proforma ${job.proforma_number}: its lines and prices are copied in.` : 'No proforma: you enter the prices.' %></p>
            <a class="btn btn-outline-primary" href="/jobs/<%= job.id %>/invoice"><i class="bi bi-receipt"></i>Make the invoice</a>
          <% } else { %>
            <p class="small text-body-secondary mb-0">Cancelled jobs aren’t invoiced.</p>
          <% } %>
        </div>
      </section>
      <%- include('invoices/views/payments', { payments: money.payments, jobId: job.id, back: `/jobs/${job.id}`, methods: paymentMethods, today, due: money.due,
            financierName: inv?.financier_name ?? null, canRecord: job.status !== 'cancelled' }) %>
    <% } %>

    <% if (requests.length || canAskMaterials) { %>
      <section class="card">
        <div class="card-header"><h2 class="h6 mb-0">Materials asked for</h2></div>
        <% if (requests.length) { %>
          <ul class="list-group list-group-flush">
            <% requests.forEach((r) => { const rs = requestStatuses[r.status]; %>
              <li class="list-group-item d-flex align-items-center gap-2">
                <a class="font-monospace small" href="/purchase-requests/<%= r.id %>"><%= r.number %></a>
                <span class="ms-auto"><%- include('partials/pill', { text: rs.label, tone: rs.tone }) %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="card-body small text-body-secondary">Nothing yet. Ask stores for anything this job needs that isn’t in stock.</div>
        <% } %>
        <% if (canAskMaterials) { %>
          <div class="card-body border-top"><a class="btn btn-outline-primary w-100" href="/purchase-requests/new?job=<%= encodeURIComponent(job.number) %>"><i class="bi bi-inbox"></i>Ask for materials</a></div>
        <% } %>
      </section>
    <% } %>

    <% if (orders.length) { %>
      <section class="card">
        <div class="card-header"><h2 class="h6 mb-0">Purchase orders</h2></div>
        <ul class="list-group list-group-flush">
          <% orders.forEach((o) => { const os = orderStatuses[o.status]; %>
            <li class="list-group-item d-flex align-items-center gap-2">
              <a class="font-monospace small" href="/purchase-orders/<%= o.id %>"><%= o.number %></a>
              <span class="ms-auto"><%- include('partials/pill', { text: os.label, tone: os.tone }) %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Details</h2></div>
      <div class="card-body">
        <dl class="jt-kv">
          <div><dt>Customer</dt><dd>
            <% if (job.customer_is_stock) { %><%- include('partials/pill', { text: 'Stock build', tone: 'info' }) %> <span class="d-block small text-body-secondary">No customer yet: built for stock, to sell to whoever comes.</span><% } else if (canSeeCustomers) { %><a href="/customers/<%= job.customer_id %>"><%= job.customer_name %></a><% } else { %><%= job.customer_name %><% } %>
            <span class="d-block small font-monospace"><%= fmt.phone(job.customer_phone) %></span>
          </dd></div>
          <div><dt>Job type</dt><dd><%= job.job_type_name ?? '—' %></dd></div>
          <div><dt>Vehicle</dt><dd>
            <% if (job.vehicle_id) { %>
              <% if (canSeeCustomers) { %><a href="/vehicles/<%= job.vehicle_id %>"><%= job.vehicle_label %></a><% } else { %><%= job.vehicle_label %><% } %>
              <% if (details) { %><span class="d-block small text-body-secondary"><%= details %></span><% } %>
            <% } else if (job.vehicle_description) { %>
              <%= job.vehicle_description %><span class="d-block small text-body-secondary">Not registered yet</span>
            <% } else { %>
              <span class="text-body-secondary">Not chosen yet</span>
            <% } %>
            <% if (!job.vehicle_id && canManage && active) { %><a class="d-block small" href="/jobs/<%= job.id %>/edit">Add the vehicle when it arrives</a><% } %>
          </dd></div>
          <div><dt>Check-in</dt><dd>
            <% if (job.checkin_id) { %>
              <% if (canSeeCustomers) { %><a class="font-monospace" href="/check-in/<%= job.checkin_id %>"><%= job.checkin_number %></a><% } else { %><span class="font-monospace"><%= job.checkin_number %></span><% } %>
              <% if (job.checkin_status === 'checked_out') { %><span class="d-block small text-body-secondary">Vehicle has left</span><% } %>
            <% } else { %><span class="text-body-secondary"><%= job.vehicle_id ? 'Not checked in yet' : '—' %></span>
              <% if (job.vehicle_id && canCheckIn && active) { %><a class="d-block small" href="/check-in/new?vehicle_id=<%= job.vehicle_id %>"><i class="bi bi-box-arrow-in-right"></i> Check it in</a><% } %>
            <% } %>
          </dd></div>
          <div><dt>Proforma</dt><dd>
            <% if (job.proforma_id && canSeeProforma) { %><a class="font-monospace" href="/proformas/<%= job.proforma_id %>"><%= job.proforma_number %></a>
            <% } else if (job.proforma_id) { %><span class="font-monospace"><%= job.proforma_number %></span>
            <% } else if (job.pending_proforma) { %>
              <% if (canSeeProforma) { %><a class="font-monospace" href="/proformas/<%= job.pending_proforma.id %>"><%= job.pending_proforma.number %></a><% } else { %><span class="font-monospace"><%= job.pending_proforma.number %></span><% } %>
              <span class="d-block small text-body-secondary"><%= job.pending_proforma.status === 'draft' ? 'Draft, not sent yet' : 'Sent, waiting for the customer' %></span>
            <% } else { %>—<% if (canMakeProforma) { %><a class="d-block small" href="/proformas/new?job=<%= job.id %>"><i class="bi bi-receipt"></i> Make proforma</a><% } %>
              <% if (!waitingForPrice) { %><%- include('match-proforma', { job, matchable, canSeeProforma, small: true }) %><% } %>
            <% } %>
          </dd></div>
          <div><dt>Supervisor</dt><dd>
            <%= job.supervisor_name ?? '—' %>
            <% if (canChangeSupervisor) { %>
              <div x-data="{ edit: false }">
                <button type="button" class="btn btn-link btn-sm p-0" x-show="!edit" @click="edit = true; $nextTick(() => $refs.pick.focus())"><%= job.supervisor_id ? 'Change' : 'Choose' %></button>
                <form method="post" action="/jobs/<%= job.id %>/supervisor" class="d-grid gap-2 mt-1" x-show="edit" x-cloak>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="visually-hidden" for="change-supervisor">Supervisor</label>
                  <select class="form-select form-select-sm" id="change-supervisor" name="supervisor_id" x-ref="pick">
                    <option value="">No one yet</option>
                    <% supervisorChoices.forEach((u) => { %><option value="<%= u.value %>"<%= u.value === job.supervisor_id ? ' selected' : '' %>><%= u.label %></option><% }) %>
                  </select>
                  <div class="d-flex gap-2"><button class="btn btn-primary btn-sm" type="submit">Save</button><button class="btn btn-link btn-sm" type="button" @click="edit = false">Keep</button></div>
                </form>
              </div>
            <% } %>
          </dd></div>
          <% if (job.responsible_name) { %><div><dt>Responsible</dt><dd><%= job.responsible_name %><span class="d-block small text-body-secondary">Not an app user</span></dd></div><% } %>
          <div><dt>Promised by</dt><dd><%= promised ?? '—' %></dd></div>
          <div><dt>Opened</dt><dd><%= fmt.date(job.created_at) %><% if (job.created_name) { %><span class="d-block small text-body-secondary">By <%= job.created_name %></span><% } %></dd></div>
        </dl>
      </div>
    </section>
  </div>
</div>
