<div class="jt-page-header">
  <div>
    <div class="jt-crumb">Account</div>
    <h1>Change password</h1>
    <p class="jt-page-sub">
      <% if (forced) { %>Choose your own password before you start. You'll use it every time you log in.<% } else { %>Use at least 8 characters. A short sentence is easier to remember than random letters.<% } %>
    </p>
  </div>
</div>

<div class="card jt-narrow">
  <div class="card-body">
    <form method="post" action="/account/password" novalidate x-data="{ show: false }">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label" for="current"><%= forced ? 'Password you were given' : 'Current password' %></label>
        <input class="form-control<%= errors.current ? ' is-invalid' : '' %>" id="current" name="current" type="password" autocomplete="current-password" required autofocus>
        <% if (errors.current) { %><div class="invalid-feedback"><%= errors.current %></div><% } %>
      </div>

      <div class="mb-3">
        <label class="form-label" for="password">New password</label>
        <input class="form-control<%= errors.password ? ' is-invalid' : '' %>" id="password" name="password" :type="show ? 'text' : 'password'" type="password" autocomplete="new-password" minlength="8" required>
        <% if (errors.password) { %><div class="invalid-feedback"><%= errors.password %></div><% } %>
      </div>

      <div class="mb-3">
        <label class="form-label" for="confirm">New password again</label>
        <input class="form-control<%= errors.confirm ? ' is-invalid' : '' %>" id="confirm" name="confirm" :type="show ? 'text' : 'password'" type="password" autocomplete="new-password" required>
        <% if (errors.confirm) { %><div class="invalid-feedback"><%= errors.confirm %></div><% } %>
      </div>

      <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="show" x-model="show">
        <label class="form-check-label" for="show">Show passwords</label>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i>Save new password</button>
        <% if (!forced) { %><a class="btn btn-outline-secondary" href="/">Cancel</a><% } %>
      </div>
    </form>
  </div>
</div>
