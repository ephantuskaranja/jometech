<%#
  Account → My signature. Drawn once; printed on the documents this person is responsible for
  (job cards they supervise, invoices and proformas they raise, receiving and release notes,
  purchase orders they approve). Uses the same signature box as the customer's sign-off.
%>
<div class="jt-page-header">
  <div>
    <div class="jt-crumb">Account</div>
    <h1>My signature</h1>
    <p class="jt-page-sub">Sign once here. It is added to the documents you are responsible for when they are printed, so you don’t sign each copy by hand.</p>
  </div>
</div>

<div class="jt-narrow d-grid gap-4">
  <% if (saved) { %>
    <section class="card">
      <div class="card-header d-flex align-items-center gap-2">
        <h2 class="h6 mb-0 me-auto">Saved signature</h2>
        <span class="small text-body-secondary">Saved <%= fmt.dateTime(saved.at) %></span>
      </div>
      <div class="card-body d-grid gap-3">
        <img class="jt-signature" src="<%= saved.url %>" alt="Your saved signature">
        <form method="post" action="/account/signature/delete" x-data @submit="if (!confirm('Remove your signature? Documents will print with a blank line instead.')) $event.preventDefault()">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-link btn-sm p-0 text-danger" type="submit"><i class="bi bi-trash"></i>Remove it</button>
        </form>
      </div>
    </section>
  <% } %>

  <form method="post" action="/account/signature" novalidate class="card" x-data="signaturePad" @submit="submit($event)">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="signature" x-ref="output">
    <div class="card-header"><h2 class="h6 mb-0"><%= saved ? 'Sign again to replace it' : 'Sign here' %></h2></div>
    <div class="card-body d-grid gap-3">
      <div class="jt-field">
        <div class="d-flex align-items-end">
          <span class="form-label mb-2" id="sign-label">Your signature<span class="jt-req" aria-hidden="true">*</span></span>
          <button type="button" class="btn btn-link btn-sm ms-auto mb-1" @click="clear()" :disabled="empty"><i class="bi bi-eraser"></i>Clear</button>
        </div>
        <div class="jt-sign-pad<%= error ? ' is-invalid' : '' %>" :class="{ 'is-invalid': missing }">
          <canvas x-ref="canvas" role="img" aria-labelledby="sign-label"
                  @pointerdown="start($event)" @pointermove="move($event)" @pointerup="end()" @pointercancel="end()" @pointerleave="end()"></canvas>
          <span class="jt-sign-hint" x-show="empty" aria-hidden="true"><i class="bi bi-pen"></i>Sign with your finger or a mouse</span>
          <span class="jt-sign-line" aria-hidden="true"></span>
        </div>
        <div class="jt-error-text" x-show="missing" x-cloak>Sign in the box above</div>
        <% if (error) { %><div class="jt-error-text" x-show="!missing"><%= error %></div><% } %>
      </div>
      <button class="btn btn-primary" type="submit" :disabled="busy"><i class="bi bi-check2"></i>Save my signature</button>
    </div>
  </form>
</div>
