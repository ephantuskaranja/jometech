<%#
  The gate: goods going out and coming in. The guard checks what is on the truck against what is listed,
  then taps the button. Stores can't receive a transfer until it has been logged in here.
%>
<%
  const size = (l) => (l.size_key ? `${Number(l.length)} × ${Number(l.width)} ${l.size_unit}` : '');
  const unitOf = (l) => (l.size_key ? (Number(l.quantity) === 1 ? 'piece' : 'pieces') : l.unit);
%>
<%- include('partials/page-header', {
  crumb: ['Gate', 'Goods at the gate'],
  heading: 'Goods at the gate',
  sub: `At ${site.name}. Check what is on the truck against the list, then tap the button.`,
}) %>

<%# One transfer card: what it carries, and the guard's button. %>
<% const card = (t) => { %>
  <section class="card">
    <div class="card-body d-grid gap-3">
      <div class="d-flex align-items-start gap-3 flex-wrap">
        <i class="bi <%= t.leaving ? 'bi-box-arrow-right' : 'bi-box-arrow-in-left' %> fs-3 text-body-secondary" aria-hidden="true"></i>
        <div class="me-auto">
          <div class="fw-semibold"><%= t.leaving ? `To ${t.to_name}` : `From ${t.from_name}` %></div>
          <div class="small text-body-secondary font-monospace"><%= t.number %> · stock transfer</div>
        </div>
      </div>
      <dl class="jt-kv mb-0">
        <div><dt>Carried by</dt><dd><strong><%= t.carried_by ?? 'Not given' %></strong></dd></div>
        <div><dt>Sent</dt><dd><%= fmt.dateTime(t.sent_at) %><span class="d-block small text-body-secondary">by <%= t.sent_name ?? 'a removed user' %></span></dd></div>
      </dl>
      <ul class="jt-gate-lines">
        <% t.lines.forEach((l) => { %>
          <li><span><%= l.item_name %><% if (l.size_key) { %> <small class="text-body-secondary"><%= size(l) %></small><% } %></span><strong class="jt-num"><%= fmt.qty(l.quantity) %> <%= unitOf(l) %></strong></li>
        <% }) %>
      </ul>
      <% if (t.leaving) { %>
        <form method="post" action="/gate/transfers/<%= t.id %>/out">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-box-arrow-right"></i>Left the gate</button>
        </form>
      <% } else { %>
        <form method="post" action="/gate/transfers/<%= t.id %>/in" class="d-grid gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="form-label mb-0 small" for="in-note-<%= t.id %>">Brought by / vehicle (optional)</label>
          <input class="form-control" id="in-note-<%= t.id %>" name="note" maxlength="255" placeholder="e.g. Kamau, KCB 123A">
          <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-box-arrow-in-left"></i>Arrived at the gate</button>
        </form>
      <% } %>
    </div>
  </section>
<% } %>

<div class="row g-4">
  <div class="col-lg-6 d-grid gap-3 align-content-start">
    <h2 class="h6 text-uppercase text-body-secondary mb-0">Leaving (<%= leaving.length %>)</h2>
    <% if (!leaving.length) { %>
      <section class="card"><%- include('partials/empty', { icon: 'box-arrow-right', heading: 'Nothing waiting to leave', text: 'Stock sent to another site shows here until it goes out of the gate.' }) %></section>
    <% } %>
    <% leaving.forEach(card) %>
  </div>
  <div class="col-lg-6 d-grid gap-3 align-content-start">
    <h2 class="h6 text-uppercase text-body-secondary mb-0">On the way in (<%= arriving.length %>)</h2>
    <% if (!arriving.length) { %>
      <section class="card"><%- include('partials/empty', { icon: 'box-arrow-in-left', heading: 'Nothing on its way in', text: 'Stock sent here from another site shows once it has left their gate.' }) %></section>
    <% } %>
    <% arriving.forEach(card) %>
  </div>
</div>
