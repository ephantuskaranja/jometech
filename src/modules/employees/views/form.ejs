<%# Add or edit an employee. Required: name and site. The daily rate only for managers and admins. %>
<%- include('partials/page-header', {
  crumb: ['People', { label: 'Employees', href: '/employees' }, employee ? employee.number : 'New'],
  heading: employee ? `Edit ${employee.name}` : 'New employee',
  sub: 'Only the name and site are needed. The clock ID links them to the clock-in machine.',
}) %>

<form method="post" action="<%= employee ? `/employees/${employee.id}` : '/employees' %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="card mb-4">
    <div class="card-body d-grid gap-3">
      <div class="jt-fields">
        <%- include('partials/field', { name: 'name', label: 'Full name', value: values.name, error: errors.name, required: true, autocomplete: 'off', class: 'jt-full' }) %>
        <%- include('partials/field', { name: 'site_id', label: 'Site', type: 'select', options: sites, value: values.site_id, error: errors.site_id, required: true }) %>
        <%- include('partials/field', { name: 'trade', label: 'Trade', value: values.trade, error: errors.trade, placeholder: 'e.g. Welder', attrs: 'list="trades"' }) %>
        <%- include('partials/field', { name: 'clock_ids', label: 'Clock ID', value: values.clock_ids, error: errors.clock_ids, autocomplete: 'off', inputmode: 'numeric',
              placeholder: 'e.g. 70', hint: 'The number on the clock-in machine. Two numbers? Separate them with a comma.' }) %>
        <fieldset class="jt-field">
          <legend class="form-label">Employed as</legend>
          <div class="jt-choices" style="--jt-cols: 2">
            <% Object.entries(categories).forEach(([key, label]) => { %>
              <label class="jt-choice" for="cat-<%= key %>"><input class="form-check-input" type="radio" id="cat-<%= key %>" name="category" value="<%= key %>"<%= values.category === key ? ' checked' : '' %>><span class="jt-choice-label"><%= label %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <% if (canSeePay) { %>
          <%- include('partials/field', { name: 'daily_rate', label: 'Daily rate (KES)', type: 'money', value: values.daily_rate, error: errors.daily_rate, hint: 'For payroll. Only managers and admins see it.' }) %>
        <% } %>
      </div>
      <datalist id="trades"><% trades.forEach((t) => { %><option value="<%= t %>"><% }) %></datalist>
    </div>
  </section>

  <section class="card mb-4" x-data="{ more: <%= Boolean(values.phone || values.id_no || values.joined_on || values.mpesa_phone || values.emergency_name || values.notes || Object.keys(errors).some((k) => ['phone', 'id_no', 'joined_on', 'mpesa_phone', 'emergency_phone', 'notes'].includes(k))) %> }">
    <div class="card-body d-grid gap-3">
      <div><button class="btn btn-link p-0" type="button" @click="more = !more" :aria-expanded="more">More details (optional) <i class="bi" :class="more ? 'bi-chevron-up' : 'bi-chevron-down'"></i></button></div>
      <div class="jt-fields" x-show="more" x-cloak>
        <%- include('partials/field', { name: 'phone', label: 'Phone', type: 'tel', value: values.phone, error: errors.phone, placeholder: '0712 345 678' }) %>
        <%- include('partials/field', { name: 'id_no', label: 'ID number', value: values.id_no, error: errors.id_no, inputmode: 'numeric' }) %>
        <%- include('partials/field', { name: 'mpesa_phone', label: 'M-Pesa number', type: 'tel', value: values.mpesa_phone, error: errors.mpesa_phone, hint: 'If different from the phone. For paying wages.' }) %>
        <%- include('partials/field', { name: 'joined_on', label: 'Joined', type: 'date', value: values.joined_on, error: errors.joined_on }) %>
        <%- include('partials/field', { name: 'emergency_name', label: 'Emergency contact', value: values.emergency_name, error: errors.emergency_name, placeholder: 'Name' }) %>
        <%- include('partials/field', { name: 'emergency_phone', label: 'Their phone', type: 'tel', value: values.emergency_phone, error: errors.emergency_phone }) %>
        <%- include('partials/field', { name: 'notes', label: 'Notes', type: 'textarea', rows: 2, value: values.notes, error: errors.notes, class: 'jt-full' }) %>
      </div>
    </div>
  </section>

  <div class="jt-savebar">
    <span class="jt-savebar-note"><i class="bi bi-people"></i>Staff don’t log in to the app.</span>
    <div class="jt-savebar-actions">
      <a class="btn btn-outline-secondary" href="<%= employee ? `/employees/${employee.id}` : '/employees' %>">Cancel</a>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i><%= employee ? 'Save changes' : 'Add employee' %></button>
    </div>
  </div>
</form>
