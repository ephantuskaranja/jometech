<%#
  The gate: customers' vehicles arriving (logged in here, then checked in by the workshop), and
  vehicles the workshop has released, waiting to drive out. The guard compares the vehicle and
  the person with what is shown here, then taps "Cleared out": only then is the vehicle checked out.
  Also vehicles moving between sites: cleared out here for the other site, or logged in here from it
  (then an admin, manager or supervisor confirms it was received).
%>
<%- include('partials/page-header', {
  crumb: ['Workshop', 'Vehicles at the gate'],
  heading: 'Vehicles at the gate',
  sub: `At ${site.name}. Log every vehicle that comes in; for one leaving, check the vehicle and the person with it against what is shown here.`,
}) %>

<% const vehicleHead = (v) => { const describe = [v.make, v.model, v.colour].filter(Boolean).join(' · '); return { describe }; }; %>

<%# Moves between sites first: a vehicle sent here is logged in against its move, not as a new arrival. %>
<% if (canRelease) { %>
<% if (moves.leaving.length || moves.arriving.length) { %>
  <h2 class="h6 text-body-secondary text-uppercase mb-3">To and from other sites</h2>
  <div class="d-grid gap-3 mb-4">
    <% moves.leaving.forEach((m) => { %>
      <section class="card">
        <div class="card-body d-grid gap-3">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <% if (m.reg_no) { %><%- include('partials/plate', { reg: m.reg_no, size: 'lg' }) %><% } else { %><strong class="font-monospace fs-5"><%= vehicleLabel(m) %></strong><% } %>
            <div>
              <div class="fw-semibold"><%= vehicleHead(m).describe || 'Vehicle' %></div>
              <div class="small text-body-secondary"><%= m.customer_name %></div>
            </div>
            <span class="ms-auto"><%- include('partials/pill', { text: `Going to ${m.to_site_name}`, tone: 'info' }) %></span>
          </div>
          <dl class="jt-kv mb-0">
            <div><dt>Driver</dt><dd><strong><%= m.driver_name %></strong><% if (m.driver_phone) { %><span class="d-block small"><%= fmt.phone(m.driver_phone) %></span><% } %></dd></div>
            <div><dt>People</dt><dd><%= m.people %><span class="d-block small text-body-secondary">driver included</span></dd></div>
            <div><dt>Movement</dt><dd><span class="font-monospace"><%= m.number %></span><a class="d-block small" href="/movements/<%= m.id %>/print"><i class="bi bi-printer"></i> Gate pass</a></dd></div>
            <div><dt>Sent</dt><dd><%= fmt.dateTime(m.sent_at) %></dd></div>
            <% if (m.notes) { %><div><dt>Notes</dt><dd><%= m.notes %></dd></div><% } %>
          </dl>
          <form method="post" action="/movements/<%= m.id %>/gate-out">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-box-arrow-right"></i>Cleared out to <%= m.to_site_name %></button>
          </form>
        </div>
      </section>
    <% }) %>
    <% moves.arriving.forEach((m) => { %>
      <section class="card">
        <div class="card-body d-grid gap-3">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <% if (m.reg_no) { %><%- include('partials/plate', { reg: m.reg_no, size: 'lg' }) %><% } else { %><strong class="font-monospace fs-5"><%= vehicleLabel(m) %></strong><% } %>
            <div>
              <div class="fw-semibold"><%= vehicleHead(m).describe || 'Vehicle' %></div>
              <div class="small text-body-secondary"><%= m.customer_name %></div>
            </div>
            <span class="ms-auto"><%- include('partials/pill', { text: `From ${m.from_site_name}`, tone: 'warn' }) %></span>
          </div>
          <dl class="jt-kv mb-0">
            <div><dt>Driver</dt><dd><strong><%= m.driver_name %></strong><% if (m.driver_phone) { %><span class="d-block small"><%= fmt.phone(m.driver_phone) %></span><% } %></dd></div>
            <div><dt>People</dt><dd><%= m.people %><span class="d-block small text-body-secondary">driver included</span></dd></div>
            <div><dt>Movement</dt><dd><span class="font-monospace"><%= m.number %></span><a class="d-block small" href="/movements/<%= m.id %>/print"><i class="bi bi-printer"></i> Gate pass</a></dd></div>
            <div><dt>Left <%= m.from_site_name %></dt><dd><%= fmt.dateTime(m.gate_out_at) %></dd></div>
          </dl>
          <form method="post" action="/movements/<%= m.id %>/gate-in" class="d-grid gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%- include('partials/field', { name: 'gate_in_note', id: `gate-in-note-${m.id}`, label: 'Note (optional)', placeholder: 'e.g. Arrived with a flat tyre' }) %>
            <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-box-arrow-in-down"></i>Logged in at the gate</button>
          </form>
        </div>
      </section>
    <% }) %>
  </div>
<% } %>
<% } %>

<%# ---------- Arriving: logged in here, checked in by the workshop ---------- %>
<section class="card mb-4" id="arriving">
  <div class="card-header"><h2 class="h6 mb-0"><i class="bi bi-box-arrow-in-down"></i> Vehicle arriving</h2></div>
  <form method="post" action="/gate/arrivals" novalidate class="card-body d-grid gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="jt-fields">
      <%- include('partials/field', { name: 'vehicle_text', label: 'Reg, chassis or tag number', value: values.vehicle_text, error: errors.vehicle_text, required: true,
            placeholder: 'e.g. KDA 123A, or “new Isuzu chassis”', autocomplete: 'off', hint: 'A vehicle we know is found by its number.' }) %>
      <%- include('partials/field', { name: 'driver_name', label: 'Driver', value: values.driver_name, error: errors.driver_name, required: true, autocomplete: 'off' }) %>
      <%- include('partials/field', { name: 'driver_phone', label: 'Driver’s phone', type: 'tel', value: values.driver_phone, error: errors.driver_phone, placeholder: '0712 345 678' }) %>
    </div>
    <%- include('partials/choices', { name: 'purpose', label: 'Why it came', required: true, options: purposes, value: values.purpose, error: errors.purpose, columns: 4 }) %>
    <%- include('partials/field', { name: 'note', label: 'Note (optional)', value: values.note, error: errors.note, placeholder: 'e.g. Came with a flat tyre' }) %>
    <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-box-arrow-in-down"></i>Log it in</button>
  </form>
</section>

<%- include('checkins/views/arrivals-waiting', { waiting, back: 'gate' }) %>


<% if (canRelease) { %>
  <h2 class="h6 text-body-secondary text-uppercase mb-3">Released to customers</h2>

<% if (!list.length) { %>
  <section class="card">
    <%- include('partials/empty', { icon: 'box-arrow-right', heading: 'No vehicle waiting to leave', text: 'Vehicles appear here once the workshop releases them to the person collecting.' }) %>
  </section>
<% } else { %>
  <div class="d-grid gap-3">
    <% list.forEach((v) => { const describe = [v.make, v.model, v.colour].filter(Boolean).join(' · '); %>
      <section class="card">
        <div class="card-body d-grid gap-3">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <% if (v.reg_no) { %><%- include('partials/plate', { reg: v.reg_no, size: 'lg' }) %><% } else { %><strong class="font-monospace fs-5"><%= vehicleLabel(v) %></strong><% } %>
            <div>
              <div class="fw-semibold"><%= describe || 'Vehicle' %></div>
              <div class="small text-body-secondary"><%= v.customer_name %></div>
            </div>
          </div>
          <dl class="jt-kv mb-0">
            <div><dt>Collected by</dt><dd><strong><%= v.collector_name %></strong>
              <span class="d-block small"><% if (!v.collector_phone && !v.collector_id_no) { %>No phone or ID given<% } %><%= v.collector_phone ? fmt.phone(v.collector_phone) : '' %><% if (v.collector_id_no) { %><%= v.collector_phone ? ' · ' : '' %>ID <%- include('partials/masked', { value: v.collector_id_no, reveal: revealUrl('release', v.id, 'collector_id_no') }) %><% } %></span></dd></div>
            <% if (v.chassis_no) { %><div><dt>Chassis</dt><dd class="font-monospace"><%= v.chassis_no %></dd></div><% } %>
            <div><dt>Release note</dt><dd class="font-monospace"><%= v.release_number %></dd></div>
            <div><dt>Released</dt><dd><%= fmt.dateTime(v.released_at) %><span class="d-block small text-body-secondary">by <%= v.released_by_name ?? 'a removed user' %></span></dd></div>
          </dl>
          <form method="post" action="/check-in/<%= v.id %>/clear">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-box-arrow-right"></i>Cleared out</button>
          </form>
        </div>
      </section>
    <% }) %>
  </div>
<% } %>
<% } %>
