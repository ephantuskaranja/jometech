<%# One check-in: the digital Truck Receiving Document. %>
<section class="card mb-4">
  <div class="card-body jt-record">
    <div class="jt-crumb">Workshop <i class="bi bi-chevron-right"></i><a href="/check-in">Check-in</a><i class="bi bi-chevron-right"></i><span><%= checkin.number %></span></div>
    <div class="jt-record-top">
      <% if (checkin.reg_no) { %><%- include('partials/plate', { reg: checkin.reg_no, size: 'lg' }) %><% } %>
      <div class="jt-record-title">
        <h1 class="h3"><%= checkin.number %> <%- include('partials/pill', { text: status.label, tone: status.tone }) %></h1>
        <div class="jt-meta">
          <span><i class="bi bi-truck"></i><a href="/vehicles/<%= checkin.vehicle_id %>"><%= vehicleLabel(checkin) %></a><%= [checkin.make, checkin.model].filter(Boolean).length ? ` · ${[checkin.make, checkin.model].filter(Boolean).join(' ')}` : '' %></span>
          <span><i class="bi bi-clock"></i><%= fmt.dateTime(checkin.checked_in_at) %></span>
          <span><i class="bi bi-geo-alt"></i><%= checkin.site_name %></span>
        </div>
      </div>
      <a class="btn btn-outline-secondary" href="/check-in/<%= checkin.id %>/print" target="_blank" rel="noopener"><i class="bi bi-printer"></i>Receiving note</a>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-lg-7 d-grid gap-4 align-content-start">
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Vehicle and owner</h2></div>
      <div class="card-body">
        <dl class="jt-kv">
          <div><dt>Owner</dt><dd><a href="/customers/<%= checkin.customer_id %>"><%= checkin.customer_name %></a> <span class="text-body-tertiary small"><%= checkin.customer_number %></span></dd></div>
          <div><dt>Brought in by</dt><dd>
            <% if (checkin.contact_name) { %>
              <%= checkin.contact_name %><%= checkin.contact_role ? ` · ${checkin.contact_role}` : '' %>
              <% if (checkin.contact_company_id !== checkin.customer_id) { %><span class="d-block small text-body-secondary">of <a href="/customers/<%= checkin.contact_company_id %>"><%= checkin.contact_company %></a></span><% } %>
              <% if (checkin.contact_phone) { %><span class="d-block small font-monospace"><%= fmt.phone(checkin.contact_phone) %></span><% } %>
            <% } else if (checkin.driver_name) { %>
              <%# Not in the system: the name they gave when signing. %>
              <%= checkin.driver_name %>
              <% if (checkin.driver_phone) { %><span class="d-block small font-monospace"><%= fmt.phone(checkin.driver_phone) %></span><% } %>
              <span class="d-block small text-body-secondary">Not saved as a contact</span>
            <% } else { %>—<% } %>
          </dd></div>
          <div><dt>Reg number</dt><dd><%= checkin.reg_no ?? '—' %></dd></div>
          <div><dt>Chassis number</dt><dd class="font-monospace"><%= checkin.chassis_no ?? '—' %></dd></div>
          <% if (checkin.temp_tag) { %><div><dt>Temporary tag</dt><dd class="font-monospace"><%= checkin.temp_tag %></dd></div><% } %>
          <div><dt>Odometer</dt><dd><%= checkin.odometer_not_working ? 'Meter not working' : (checkin.odometer_km != null ? `${fmt.qty(checkin.odometer_km)} km` : '—') %></dd></div>
          <div><dt>Fuel</dt><dd><%= fuel ?? '—' %></dd></div>
          <div><dt>Received by</dt><dd><%= checkin.received_by_name %></dd></div>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Items received</h2></div>
      <% if (checkin.items.length) { %>
        <div class="table-responsive">
          <table class="table jt-table mb-0">
            <thead><tr><th style="width: 3rem">#</th><th>Item description</th><th class="text-end">Qty</th></tr></thead>
            <tbody>
              <% checkin.items.forEach((item, i) => { %>
                <tr><td class="text-body-tertiary"><%= i + 1 %></td><td><%= item.description %></td><td class="text-end jt-num"><%= item.quantity %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card-body text-body-secondary small">No loose items recorded.</div>
      <% } %>
      <% if (checkin.remarks) { %>
        <div class="card-body border-top">
          <div class="small fw-semibold mb-1">Remarks</div>
          <p class="mb-0" style="white-space: pre-line"><%= checkin.remarks %></p>
        </div>
      <% } %>
    </section>

    <%- include('photos', { photos }) %>
  </div>

  <div class="col-lg-5 d-grid gap-4 align-content-start">
    <% if (checkin.status === 'checked_out') { %>
      <section class="card">
        <div class="card-body d-flex gap-3 align-items-start">
          <i class="bi bi-box-arrow-right fs-4 text-success"></i>
          <div>
            <div class="fw-semibold">Checked out <%= fmt.dateTime(checkin.checked_out_at) %></div>
            <div class="small text-body-secondary">By <%= checkin.checked_out_by_name ?? 'a removed user' %>, after <%= daysIn.toLowerCase() === 'today' ? 'less than a day' : daysIn %> in the workshop.</div>
          </div>
        </div>
      </section>
    <% } else if (canCheckOut) { %>
      <section class="card" x-data="{ open: false }">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3">
            <div class="me-auto">
              <div class="fw-semibold">In the workshop<%= daysIn === 'Today' ? ' since today' : ` for ${daysIn}` %></div>
              <div class="small text-body-secondary">Arrived <%= fmt.dateTime(checkin.checked_in_at) %></div>
            </div>
            <button type="button" class="btn btn-outline-primary" x-show="!open" @click="open = true"><i class="bi bi-box-arrow-right"></i>Check out</button>
          </div>
          <div x-show="open" x-cloak>
            <form method="post" action="/check-in/<%= checkin.id %>/check-out" class="d-grid gap-3 mt-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (!checkin.driver_signed_at && !checkin.not_signed_reason) { %>
                <div class="jt-warn-box"><i class="bi bi-exclamation-triangle"></i><span>The driver hasn’t confirmed this check-in. After check-out it can’t be signed.</span></div>
              <% } %>
              <p class="small mb-0">This records that the vehicle has left the workshop. The check-in, its signature and photos can’t be changed after this.</p>
              <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i>Yes, check it out</button>
                <button class="btn btn-link" type="button" @click="open = false">Cancel</button>
              </div>
            </form>
          </div>
        </div>
      </section>
    <% } %>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Confirmed by the driver</h2></div>
      <div class="card-body">
        <% if (checkin.driver_signed_at) { %>
          <img class="jt-signature mb-2" src="/check-in/<%= checkin.id %>/signature.png" alt="Signature of <%= checkin.driver_name %>" width="400" height="120">
          <div class="fw-semibold"><%= checkin.driver_name %></div>
          <div class="small text-body-secondary">
            <%= [checkin.driver_phone && fmt.phone(checkin.driver_phone), checkin.driver_id_no && `ID ${checkin.driver_id_no}`].filter(Boolean).join(' · ') %>
            <span class="d-block">Signed <%= fmt.dateTime(checkin.driver_signed_at) %></span>
          </div>
        <% } else if (checkin.not_signed_reason) { %>
          <div class="d-flex gap-2 align-items-start small"><%- include('partials/pill', { text: 'Not signed', tone: 'warn' }) %><span><%= checkin.not_signed_reason %></span></div>
        <% } else if (checkin.status !== 'in_workshop') { %>
          <div class="d-flex gap-2 align-items-start small"><%- include('partials/pill', { text: 'Not signed', tone: 'warn' }) %><span>Checked out before the driver confirmed.</span></div>
        <% } else { %>
          <p class="small text-body-secondary mb-3"><i class="bi bi-hourglass-split"></i> Waiting for the person who delivered the vehicle to check the details and sign.</p>
          <% if (canConfirm) { %><a class="btn btn-primary w-100" href="/check-in/<%= checkin.id %>/sign"><i class="bi bi-pen"></i>Driver signs now</a><% } %>
        <% } %>
      </div>
    </section>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">History</h2></div>
      <div class="card-body">
        <%- include('partials/history', { entries, labels: {} }) %>
      </div>
    </section>
  </div>
</div>
