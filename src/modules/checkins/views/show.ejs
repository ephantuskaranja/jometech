<%# One check-in: the digital Truck Receiving Document. %>
<section class="card mb-4">
  <div class="card-body jt-record">
    <div class="jt-crumb">Workshop <i class="bi bi-chevron-right"></i><a href="/check-in">Check-in</a><i class="bi bi-chevron-right"></i><span><%= checkin.number %></span></div>
    <div class="jt-record-top">
      <% if (checkin.reg_no) { %><%- include('partials/plate', { reg: checkin.reg_no, size: 'lg' }) %><% } %>
      <div class="jt-record-title">
        <h1 class="h3"><%= checkin.number %> <%- include('partials/pill', { text: status.label, tone: status.tone }) %></h1>
        <div class="jt-meta">
          <span><i class="bi bi-truck"></i><a href="/vehicles/<%= checkin.vehicle_id %>"><%= vehicleLabel(checkin) %></a><%= [checkin.make, checkin.model].filter(Boolean).length ? ` · ${[checkin.make, checkin.model].filter(Boolean).join(' ')}` : '' %></span>
          <span><i class="bi bi-clock"></i><%= fmt.dateTime(checkin.checked_in_at) %></span>
          <span><i class="bi bi-geo-alt"></i><%= checkin.site_name %></span>
        </div>
      </div>
      <a class="btn btn-outline-secondary" href="/check-in/<%= checkin.id %>/print" target="_blank" rel="noopener"><i class="bi bi-printer"></i>Receiving note</a>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-lg-7 d-grid gap-4 align-content-start">
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Vehicle and owner</h2></div>
      <div class="card-body">
        <dl class="jt-kv">
          <div><dt>Owner</dt><dd><a href="/customers/<%= checkin.customer_id %>"><%= checkin.customer_name %></a> <span class="text-body-tertiary small"><%= checkin.customer_number %></span></dd></div>
          <div><dt>Brought in by</dt><dd>
            <% if (checkin.contact_name) { %>
              <%= checkin.contact_name %><%= checkin.contact_role ? ` · ${checkin.contact_role}` : '' %>
              <% if (checkin.contact_company_id !== checkin.customer_id) { %><span class="d-block small text-body-secondary">of <a href="/customers/<%= checkin.contact_company_id %>"><%= checkin.contact_company %></a></span><% } %>
              <% if (checkin.contact_phone) { %><span class="d-block small font-monospace"><%= fmt.phone(checkin.contact_phone) %></span><% } %>
            <% } else if (checkin.brought_by_name) { %>
              <%= checkin.brought_by_name %>
              <% if (checkin.brought_by_phone) { %><span class="d-block small font-monospace"><%= fmt.phone(checkin.brought_by_phone) %></span><% } %>
              <span class="d-block small text-body-secondary">Not saved as a contact</span>
            <% } else if (checkin.driver_name) { %>
              <%# Not in the system: the name they gave when signing. %>
              <%= checkin.driver_name %>
              <% if (checkin.driver_phone) { %><span class="d-block small font-monospace"><%= fmt.phone(checkin.driver_phone) %></span><% } %>
              <span class="d-block small text-body-secondary">Not saved as a contact</span>
            <% } else { %>—<% } %>
          </dd></div>
          <div><dt>Reg number</dt><dd><%= checkin.reg_no ?? '—' %></dd></div>
          <div><dt>Chassis number</dt><dd class="font-monospace"><%= checkin.chassis_no ?? '—' %></dd></div>
          <% if (checkin.temp_tag) { %><div><dt>Temporary tag</dt><dd class="font-monospace"><%= checkin.temp_tag %></dd></div><% } %>
          <div><dt>Odometer</dt><dd><%= checkin.odometer_not_working ? 'Meter not working' : (checkin.odometer_km != null ? `${fmt.qty(checkin.odometer_km)} km` : '—') %></dd></div>
          <div><dt>Fuel</dt><dd><%= fuel ?? '—' %></dd></div>
          <div><dt>Received by</dt><dd><%= checkin.received_by_name %></dd></div>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Items received</h2></div>
      <% if (checkin.items.length) { %>
        <div class="table-responsive">
          <table class="table jt-table mb-0">
            <thead><tr><th style="width: 3rem">#</th><th>Item description</th><th class="text-end">Qty</th></tr></thead>
            <tbody>
              <% checkin.items.forEach((item, i) => { %>
                <tr><td class="text-body-tertiary"><%= i + 1 %></td><td><%= item.description %></td><td class="text-end jt-num"><%= item.quantity %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card-body text-body-secondary small">No loose items recorded.</div>
      <% } %>
      <% if (checkin.remarks) { %>
        <div class="card-body border-top">
          <div class="small fw-semibold mb-1">Remarks</div>
          <p class="mb-0" style="white-space: pre-line"><%= checkin.remarks %></p>
        </div>
      <% } %>
    </section>

    <%- include('photos', { photos }) %>
  </div>

  <div class="col-lg-5 d-grid gap-4 align-content-start">
    <% if (['released', 'checked_out'].includes(checkin.status)) { const out = checkin.status === 'checked_out'; %>
      <section class="card">
        <div class="card-body d-flex gap-3 align-items-start">
          <i class="bi bi-<%= out ? 'box-arrow-right text-success' : 'hourglass-split text-warning' %> fs-4"></i>
          <div class="flex-grow-1">
            <% if (out) { %>
              <div class="fw-semibold">Checked out <%= fmt.dateTime(checkin.checked_out_at) %></div>
              <div class="small text-body-secondary"><%= releaseRecord ? 'Cleared at the gate by' : 'By' %> <%= checkin.checked_out_by_name ?? 'a removed user' %>, after <%= daysIn.toLowerCase() === 'today' ? 'less than a day' : daysIn %> in the workshop.</div>
            <% } else { %>
              <div class="fw-semibold">Released: waiting at the gate</div>
              <div class="small text-body-secondary">Released <%= fmt.dateTime(releaseRecord.created_at) %> by <%= releaseRecord.released_by_name ?? 'a removed user' %>. It is checked out when the gate clears it.</div>
            <% } %>
            <% if (releaseRecord) { %>
              <div class="small mt-2">Collected by <strong><%= releaseRecord.collector_name %></strong><%= releaseRecord.collector_phone ? `, ${fmt.phone(releaseRecord.collector_phone)}` : '' %>.
                <%= releaseRecord.on_approval ? `Released with ${checkin.release_allowed_by_name ?? 'a manager'}’s approval: ${checkin.release_allowed_reason ?? ''}` : '' %></div>
              <a class="btn btn-outline-primary btn-sm mt-2" href="/check-in/<%= checkin.id %>/release-note"><i class="bi bi-printer"></i>Release note <%= releaseRecord.number %></a>
            <% } %>
            <% if (canClear) { %>
              <form method="post" action="/check-in/<%= checkin.id %>/clear" class="mt-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="back" value="checkin">
                <button class="btn btn-primary w-100" type="submit"><i class="bi bi-box-arrow-right"></i>Cleared out at the gate</button>
              </form>
            <% } %>
          </div>
        </div>
      </section>
    <% } else if (move) { %>
      <%# On the road between sites: the other site confirms when it arrives. %>
      <% const rv = moveForm?.form === 'receive' ? moveForm.values : {}; const re = moveForm?.form === 'receive' ? moveForm.errors : {}; %>
      <section class="card jt-move-card">
        <div class="card-body d-grid gap-3">
          <div class="d-flex gap-3 align-items-start">
            <i class="bi bi-truck fs-4 text-info"></i>
            <div>
              <div class="fw-semibold">On the way to <%= move.to_site_name %></div>
              <div class="small text-body-secondary">
                Sent from <%= move.from_site_name %> <%= fmt.dateTime(move.sent_at) %><%= move.sent_by_name ? ` by ${move.sent_by_name}` : '' %>.
                Driver: <%= move.driver_name %><%= move.driver_phone ? `, ${fmt.phone(move.driver_phone)}` : '' %><%= move.odometer_out != null ? `. Odometer ${fmt.qty(move.odometer_out)} km` : '' %>.
              </div>
              <% if (move.notes) { %><div class="small mt-1"><%= move.notes %></div><% } %>
              <div class="small text-body-tertiary font-monospace mt-1"><%= move.number %></div>
            </div>
          </div>
          <% if (canReceive) { %>
            <form method="post" action="/movements/<%= move.id %>/receive" class="d-grid gap-3 border-top pt-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="jt-fields">
                <%- include('partials/field', { name: 'odometer_in', label: 'Odometer on arrival', type: 'number', value: rv.odometer_in, error: re.odometer_in, inputmode: 'numeric', hint: 'Optional, km' }) %>
                <%- include('partials/field', { name: 'receive_notes', label: 'Notes', value: rv.receive_notes, error: re.receive_notes, hint: 'Optional, e.g. arrived with a flat tyre' }) %>
              </div>
              <div><button class="btn btn-primary" type="submit"><i class="bi bi-box-arrow-in-down"></i>Received at <%= move.to_site_name %></button></div>
            </form>
          <% } %>
          <% if (canCancelMove) { %>
            <form method="post" action="/movements/<%= move.id %>/cancel" x-data @submit="if (!confirm(<%= JSON.stringify(`Cancel this move? The vehicle stays at ${move.from_site_name}.`) %>)) $event.preventDefault()">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-link btn-sm p-0 text-body-secondary" type="submit">It didn’t leave: cancel the move</button>
            </form>
          <% } %>
        </div>
      </section>
    <% } else if (canCheckOut) { %>
      <% const sv = moveForm?.form === 'send' ? moveForm.values : {}; const se = moveForm?.form === 'send' ? moveForm.errors : {}; %>
      <section class="card" x-data="{ open: '<%= moveForm?.form === 'send' ? 'send' : '' %>' }">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="me-auto">
              <div class="fw-semibold">In the workshop<%= daysIn === 'Today' ? ' since today' : ` for ${daysIn}` %></div>
              <div class="small text-body-secondary">Arrived <%= fmt.dateTime(checkin.checked_in_at) %></div>
            </div>
            <div class="d-flex gap-2" x-show="!open">
              <% if (sendTo.length) { %><button type="button" class="btn btn-outline-secondary" @click="open = 'send'"><i class="bi bi-arrow-left-right"></i>Send to another site</button><% } %>
              <% if (releaseList.ok || checkin.release_allowed_at) { %>
                <a class="btn btn-outline-primary" href="/check-in/<%= checkin.id %>/release"><i class="bi bi-box-arrow-right"></i>Release vehicle</a>
              <% } else { %>
                <button type="button" class="btn btn-outline-primary" disabled title="The release checklist isn’t complete"><i class="bi bi-box-arrow-right"></i>Release vehicle</button>
              <% } %>
            </div>
          </div>
          <% if (sendTo.length) { %>
            <div x-show="open === 'send'" x-cloak>
              <form method="post" action="/check-in/<%= checkin.id %>/send" class="d-grid gap-3 mt-3" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (sendTo.length === 1) { %>
                  <input type="hidden" name="to_site_id" value="<%= sendTo[0].id %>">
                  <p class="mb-0">Send to <strong><%= sendTo[0].name %></strong>. It stays on this site’s list until <%= sendTo[0].name %> receives it.</p>
                  <% if (se.to_site_id) { %><div class="jt-error-text"><%= se.to_site_id %></div><% } %>
                <% } else { %>
                  <%- include('partials/field', { name: 'to_site_id', label: 'Send to', type: 'select', options: sendTo.map((s) => ({ value: s.id, label: s.name })), value: sv.to_site_id, error: se.to_site_id, blank: 'Choose the site', required: true }) %>
                <% } %>
                <div class="jt-fields">
                  <%- include('partials/field', { name: 'driver_name', label: 'Driver', value: sv.driver_name, error: se.driver_name, required: true, autocomplete: 'off' }) %>
                  <%- include('partials/field', { name: 'driver_phone', label: 'Driver’s phone', type: 'tel', value: sv.driver_phone, error: se.driver_phone, placeholder: '0712 345 678' }) %>
                  <%- include('partials/field', { name: 'odometer_out', label: 'Odometer now', type: 'number', value: sv.odometer_out, error: se.odometer_out, inputmode: 'numeric', hint: 'Optional, km' }) %>
                  <%- include('partials/field', { name: 'notes', label: 'Notes', value: sv.notes, error: se.notes, hint: 'Optional, e.g. why it is moving' }) %>
                </div>
                <div class="d-flex gap-2">
                  <button class="btn btn-primary" type="submit"><i class="bi bi-send"></i>Send it</button>
                  <button class="btn btn-link" type="button" @click="open = ''">Cancel</button>
                </div>
              </form>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>
    <% if (releaseList) { %>
      <%- include('release-checklist', { list: releaseList, canAllow, showMoney: canAllow }) %>
    <% } %>
    <% if (jobs.length || canStartJob) { %>
      <section class="card">
        <div class="card-header d-flex align-items-center">
          <h2 class="h6 mb-0 me-auto">Jobs</h2>
          <% if (canStartJob) { %><a class="btn btn-outline-secondary btn-sm" href="/jobs/new?vehicle_id=<%= checkin.vehicle_id %>"><i class="bi bi-plus-lg"></i>New job</a><% } %>
        </div>
        <% if (jobs.length) { %>
          <ul class="list-group list-group-flush">
            <% jobs.forEach((j) => { const js = jobStatuses[j.status]; %>
              <li class="list-group-item d-flex align-items-center gap-2">
                <a class="font-monospace small" href="/jobs/<%= j.id %>"><%= j.number %></a>
                <span class="ms-auto"><%- include('partials/pill', { text: js.label, tone: js.tone }) %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="card-body text-body-secondary small">No job for this visit yet.</div>
        <% } %>
      </section>
    <% } %>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Confirmed by the driver</h2></div>
      <div class="card-body">
        <% if (checkin.driver_signed_at) { %>
          <img class="jt-signature mb-2" src="/check-in/<%= checkin.id %>/signature.png" alt="Signature of <%= checkin.driver_name %>" width="400" height="120">
          <div class="fw-semibold"><%= checkin.driver_name %></div>
          <div class="small text-body-secondary">
            <%= [checkin.driver_phone && fmt.phone(checkin.driver_phone), checkin.driver_id_no && `ID ${checkin.driver_id_no}`].filter(Boolean).join(' · ') %>
            <span class="d-block">Signed <%= fmt.dateTime(checkin.driver_signed_at) %></span>
          </div>
        <% } else if (checkin.not_signed_reason) { %>
          <div class="d-flex gap-2 align-items-start small"><%- include('partials/pill', { text: 'Not signed', tone: 'warn' }) %><span><%= checkin.not_signed_reason %></span></div>
        <% } else if (checkin.status !== 'in_workshop') { %>
          <div class="d-flex gap-2 align-items-start small"><%- include('partials/pill', { text: 'Not signed', tone: 'warn' }) %><span>Released before the driver confirmed.</span></div>
        <% } else { %>
          <p class="small text-body-secondary mb-3"><i class="bi bi-hourglass-split"></i> Waiting for the person who delivered the vehicle to check the details and sign.</p>
          <% if (canConfirm) { %><a class="btn btn-primary w-100" href="/check-in/<%= checkin.id %>/sign"><i class="bi bi-pen"></i>Driver signs now</a><% } %>
        <% } %>
      </div>
    </section>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">History</h2></div>
      <div class="card-body">
        <%- include('partials/history', { entries, labels: {} }) %>
      </div>
    </section>
  </div>
</div>
