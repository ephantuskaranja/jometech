<%#
  Handover: the person delivering the vehicle checks the summary and signs with a finger.
  They are not a user; staff hand them the phone or tablet. "Confirmed by" on the paper form.
%>
<%
  const describe = [checkin.make, checkin.model].filter(Boolean).join(' ') || typeLabel(checkin.type);
  const notSigned = Boolean(errors.reason);
%>
<div class="jt-sign">
  <div class="jt-sign-head">
    <div class="jt-crumb">Workshop <i class="bi bi-chevron-right"></i><a href="/check-in">Check-in</a><i class="bi bi-chevron-right"></i><a href="/check-in/<%= checkin.id %>"><%= checkin.number %></a><i class="bi bi-chevron-right"></i><span>Confirm</span></div>
    <h1>Confirm delivery</h1>
    <p class="jt-page-sub">Please check the details below. If they are right, type your name and sign in the box.</p>
  </div>

  <section class="card mb-4">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
        <% if (checkin.reg_no) { %><%- include('partials/plate', { reg: checkin.reg_no, size: 'lg' }) %><% } else { %><strong class="font-monospace fs-5"><%= vehicleLabel(checkin) %></strong><% } %>
        <span class="fs-5"><%= describe %></span>
        <span class="ms-auto font-monospace text-body-secondary"><%= checkin.number %></span>
      </div>
      <dl class="jt-kv">
        <div><dt>Owner</dt><dd><%= checkin.customer_name %></dd></div>
        <div><dt>Received</dt><dd><%= fmt.dateTime(checkin.checked_in_at) %>, by <%= checkin.received_by_name %></dd></div>
        <% if (checkin.chassis_no) { %><div><dt>Chassis number</dt><dd class="font-monospace"><%= checkin.chassis_no %></dd></div><% } %>
        <% if (checkin.temp_tag) { %><div><dt>Temporary tag</dt><dd class="font-monospace"><%= checkin.temp_tag %></dd></div><% } %>
        <div><dt>Odometer</dt><dd><%= checkin.odometer_not_working ? 'Meter not working' : (checkin.odometer_km != null ? `${fmt.qty(checkin.odometer_km)} km` : 'Not recorded') %></dd></div>
        <div><dt>Fuel</dt><dd><%= fuel ?? 'Not recorded' %></dd></div>
      </dl>
    </div>
    <div class="border-top">
      <% if (checkin.items.length) { %>
        <table class="table jt-table mb-0">
          <thead><tr><th style="width: 3rem">#</th><th>Items received with the vehicle</th><th class="text-end">Qty</th></tr></thead>
          <tbody>
            <% checkin.items.forEach((item, i) => { %>
              <tr><td class="text-body-tertiary"><%= i + 1 %></td><td><%= item.description %></td><td class="text-end jt-num fw-semibold"><%= item.quantity %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="card-body text-body-secondary">No loose items were received with the vehicle.</div>
      <% } %>
    </div>
    <% if (checkin.remarks) { %>
      <div class="card-body border-top">
        <div class="small fw-semibold mb-1">Remarks</div>
        <p class="mb-0" style="white-space: pre-line"><%= checkin.remarks %></p>
      </div>
    <% } %>
  </section>

  <div class="mb-4"><%- include('photos', { photos }) %></div>

  <form method="post" action="/check-in/<%= checkin.id %>/sign" novalidate class="card mb-4" x-data="signaturePad" @submit="submit($event)">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="signature" x-ref="output">
    <div class="card-body d-grid gap-3">
      <p class="jt-sign-statement mb-0">
        I delivered this vehicle to Jome-Tech Engineering with the items listed above.
      </p>
      <div class="jt-fields">
        <%- include('partials/field', { name: 'driver_name', label: 'Your full name', value: values.driver_name, error: errors.driver_name, required: true, autocomplete: 'off', class: 'jt-full' }) %>
        <%- include('partials/field', { name: 'driver_phone', label: 'Your phone number', type: 'tel', value: values.driver_phone, error: errors.driver_phone, placeholder: '0712 345 678' }) %>
        <%- include('partials/field', { name: 'driver_id_no', label: 'ID number', value: values.driver_id_no, error: errors.driver_id_no, inputmode: 'numeric', hint: 'Optional' }) %>
      </div>

      <div class="jt-field">
        <div class="d-flex align-items-end">
          <span class="form-label mb-2" id="sign-label">Sign here<span class="jt-req" aria-hidden="true">*</span></span>
          <button type="button" class="btn btn-link btn-sm ms-auto mb-1" @click="clear()" :disabled="empty"><i class="bi bi-eraser"></i>Clear</button>
        </div>
        <div class="jt-sign-pad<%= errors.signature ? ' is-invalid' : '' %>" :class="{ 'is-invalid': missing }">
          <canvas x-ref="canvas" role="img" aria-labelledby="sign-label"
                  @pointerdown="start($event)" @pointermove="move($event)" @pointerup="end()" @pointercancel="end()" @pointerleave="end()"></canvas>
          <span class="jt-sign-hint" x-show="empty" aria-hidden="true"><i class="bi bi-pen"></i>Sign with your finger</span>
          <span class="jt-sign-line" aria-hidden="true"></span>
        </div>
        <div class="jt-error-text" x-show="missing" x-cloak>Sign in the box above</div>
        <% if (errors.signature) { %><div class="jt-error-text" x-show="!missing"><%= errors.signature %></div><% } %>
      </div>

      <button class="btn btn-primary btn-lg w-100" type="submit" :disabled="busy"><i class="bi bi-check2-circle"></i>Confirm and sign</button>
    </div>
  </form>

  <%# For staff: when the driver has left or refuses. %>
  <section class="card" x-data="{ open: <%= notSigned %>, reason: '<%= values.reason ?? '' %>' }">
    <div class="card-body">
      <button class="btn btn-link p-0 text-body-secondary" type="button" @click="open = !open" :aria-expanded="open">
        <i class="bi bi-person-x"></i>The driver can’t sign <i class="bi" :class="open ? 'bi-chevron-up' : 'bi-chevron-down'"></i>
      </button>
      <div x-show="open" x-cloak>
      <form method="post" action="/check-in/<%= checkin.id %>/not-signed" novalidate class="d-grid gap-3 mt-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="jt-field">
          <legend class="form-label">Why not?</legend>
          <div class="jt-choices" style="--jt-cols: 2">
            <% [...reasons, 'other'].forEach((r, i) => { %>
              <label class="jt-choice" for="reason-<%= i %>">
                <input class="form-check-input" type="radio" id="reason-<%= i %>" name="reason" value="<%= r %>" x-model="reason">
                <span class="jt-choice-label"><%= r === 'other' ? 'Something else' : r %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>
        <div x-show="reason === 'other'">
          <%- include('partials/field', { name: 'other_reason', label: 'Reason', value: values.other_reason, placeholder: 'e.g. Truck brought in on a low-loader' }) %>
        </div>
        <% if (errors.reason) { %><div class="jt-error-text"><%= errors.reason %></div><% } %>
        <div><button class="btn btn-outline-secondary" type="submit" :disabled="!reason">Save without a signature</button></div>
      </form>
      </div>
    </div>
  </section>
</div>
