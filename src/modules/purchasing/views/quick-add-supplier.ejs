<%# Small window for adding a supplier without leaving the purchase order. %>
<div class="modal fade" id="quick-add-supplier" tabindex="-1" aria-labelledby="qas-title" aria-hidden="true"
     x-data="quickAddSupplier" @jt:quick-add-supplier.window="open($event.detail)" x-init="$el.addEventListener('hidden.bs.modal', () => cancelled())">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" @submit.prevent="save()" novalidate>
      <div class="modal-header">
        <h2 class="modal-title h5" id="qas-title">New supplier</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body d-grid gap-3">
        <div class="jt-field">
          <label class="form-label" for="qas-name">Name<span class="jt-req" aria-hidden="true">*</span></label>
          <input class="form-control" id="qas-name" x-model="name" :class="errors.name && 'is-invalid'" autocomplete="off">
          <div class="invalid-feedback" x-text="errors.name"></div>
        </div>
        <div class="jt-field">
          <label class="form-label" for="qas-phone">Phone number</label>
          <input class="form-control" id="qas-phone" type="tel" inputmode="tel" x-ref="phone" x-model="phone" :class="errors.phone && 'is-invalid'" placeholder="0712 345 678" autocomplete="off">
          <div class="invalid-feedback" x-text="errors.phone"></div>
        </div>
        <p class="form-text mb-0">The rest can be added later on the supplier’s page.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" :disabled="busy"><i class="bi bi-check2"></i>Add supplier</button>
      </div>
    </form>
  </div>
</div>
