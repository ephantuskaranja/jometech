<div class="card jt-auth-card">
  <div class="card-body">
    <h1 class="h4 mb-1">Log in</h1>
    <p class="text-body-secondary mb-4">Use the phone number your administrator registered for you.</p>

    <% if (errors._form) { %>
      <div class="alert alert-danger d-flex gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i><span><%= errors._form %></span>
      </div>
    <% } %>

    <form method="post" action="/login" novalidate x-data="{ show: false, busy: false }" @submit="busy = true">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= values.next ?? '' %>">

      <div class="mb-3">
        <label class="form-label" for="identifier">Phone number</label>
        <input class="form-control form-control-lg<%= errors.identifier ? ' is-invalid' : '' %>" id="identifier" name="identifier"
               type="text" inputmode="tel" autocomplete="username" placeholder="0712 345 678"
               value="<%= values.identifier ?? '' %>" <%= values.identifier ? '' : 'autofocus' %> required>
        <% if (errors.identifier) { %><div class="invalid-feedback"><%= errors.identifier %></div><% } %>
      </div>

      <div class="mb-4">
        <label class="form-label" for="password">Password</label>
        <div class="input-group has-validation">
          <input class="form-control form-control-lg<%= errors.password ? ' is-invalid' : '' %>" id="password" name="password"
                 :type="show ? 'text' : 'password'" type="password" autocomplete="current-password" <%= values.identifier ? 'autofocus' : '' %> required>
          <button class="btn btn-outline-secondary" type="button" @click="show = !show" :aria-pressed="show" aria-label="Show password">
            <i class="bi" :class="show ? 'bi-eye-slash' : 'bi-eye'"></i>
          </button>
          <% if (errors.password) { %><div class="invalid-feedback"><%= errors.password %></div><% } %>
        </div>
      </div>

      <button class="btn btn-primary btn-lg w-100" type="submit" :disabled="busy">
        <span x-show="!busy">Log in</span>
        <span x-show="busy" x-cloak><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Logging in…</span>
      </button>
    </form>
  </div>
</div>
<p class="jt-auth-help">Forgot your password? Ask your administrator to reset it.</p>
