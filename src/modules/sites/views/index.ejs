<%- include('partials/page-header', {
  crumb: ['System', 'Sites'],
  heading: 'Sites',
  sub: 'Where Jome-Tech works from. Admins and managers can use every active site; anyone else is given theirs under Users.',
  actions: [{ label: 'New site', href: '/admin/sites/new', icon: 'plus-lg', primary: true }],
}) %>

<section class="card">
  <div class="table-responsive">
    <table class="table jt-table mb-0">
      <thead><tr><th>Site</th><th>Address</th><th>Phone</th><th class="text-end">Staff linked</th></tr></thead>
      <tbody>
        <% list.forEach((s) => { %>
          <tr>
            <td><a class="jt-row-link" href="/admin/sites/<%= s.id %>"><%= s.name %></a>
              <% if (!s.is_active) { %><%- include('partials/pill', { text: 'Switched off', tone: 'neutral' }) %><% } %></td>
            <td><%= s.address ?? '—' %></td>
            <td class="font-monospace small text-nowrap"><%= s.phone ? fmt.phone(s.phone) : '—' %></td>
            <td class="text-end jt-num"><%= s.staff_count %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
