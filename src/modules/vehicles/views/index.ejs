<%#
  Every customer vehicle, split by where it is now: in the workshop, left (checked out),
  registered but never visited, or all. A search looks through all of them.
%>
<%
  const tabs = [['in', 'In the workshop'], ['left', 'Left'], ['new', 'Not yet visited'], ['all', 'All']];
  const link = (changes) => {
    const p = new URLSearchParams({ place, ...(q ? { q } : {}), ...(type ? { type } : {}), ...(siteId ? { site: siteId } : {}), ...changes });
    for (const [k, v] of [...p]) if (!v) p.delete(k);
    return `/vehicles?${p}`;
  };
  const empty = {
    in: { icon: 'truck', heading: 'No vehicles in the workshop', text: 'Vehicles appear here from the moment they are checked in until they are checked out.' },
    left: { icon: 'box-arrow-right', heading: 'None have left yet', text: 'Vehicles appear here once they have been checked out.' },
    new: { icon: 'calendar-plus', heading: 'Every vehicle has visited', text: 'Vehicles registered ahead of their first visit appear here.' },
    all: { icon: 'truck', heading: 'No vehicles yet', text: 'Vehicles are added when they are first checked in, or here ahead of time.' },
  };
%>
<%- include('partials/page-header', {
  crumb: ['Sales', 'Vehicles'],
  heading: 'Vehicles',
  sub: 'Every customer’s trucks, trailers and other vehicles. Arriving now? Use Check-in: it adds the vehicle too.',
  actions: [{ label: 'Add vehicle', href: '/vehicles/new', icon: 'plus-lg', primary: true }],
}) %>

<section class="card">
  <nav class="nav nav-tabs jt-tabs">
    <% tabs.forEach(([key, label]) => { %>
      <a class="nav-link<%= place === key ? ' active' : '' %>" href="<%= link({ place: key }) %>"<%- place === key ? ' aria-current="page"' : '' %>><%= label %> <span class="badge rounded-pill"><%= counts[key] %></span></a>
    <% }) %>
  </nav>

  <form class="jt-toolbar" method="get" action="/vehicles">
    <input type="hidden" name="place" value="<%= place %>">
    <div class="jt-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input class="form-control" type="search" name="q" value="<%= q %>" placeholder="Reg, chassis, tag or owner" aria-label="Search vehicles">
    </div>
    <div style="min-width: 10rem">
      <select class="form-select" name="type" aria-label="Type" x-data @change="$el.form.submit()">
        <option value="">All types</option>
        <% types.forEach((t) => { %><option value="<%= t.value %>"<%= type === t.value ? ' selected' : '' %>><%= t.label %></option><% }) %>
      </select>
    </div>
    <% if (place === 'in' && sites.length > 1) { %>
      <div style="min-width: 9rem">
        <select class="form-select" name="site" aria-label="Site" x-data @change="$el.form.submit()">
          <option value="">All sites</option>
          <% sites.forEach((s) => { %><option value="<%= s.id %>"<%= siteId === s.id ? ' selected' : '' %>><%= s.name %></option><% }) %>
        </select>
      </div>
    <% } %>
    <span class="jt-count"><%= list.length %> <%= list.length === 1 ? 'vehicle' : 'vehicles' %><%= list.length === 200 ? ' (first 200: search to narrow)' : '' %></span>
  </form>

  <% if (list.length === 0) { %>
    <%- include('partials/empty', q
      ? { icon: 'search', heading: `No vehicle matches “${q}”`, text: place === 'all' ? 'Try the reg without spaces, the last digits of the chassis, or the owner’s name.' : 'Try the All tab, or the reg without spaces.' }
      : empty[place]) %>
  <% } else { %>
    <div class="table-responsive">
      <table class="table jt-table">
        <thead><tr>
          <th>Vehicle</th><th>Make &amp; model</th><th>Owner</th>
          <% if (place === 'in') { %><th>Site</th><th>Check-in</th><th class="text-end">Days in</th>
          <% } else if (place === 'left') { %><th>Left</th><th class="text-end">Visits</th>
          <% } else if (place === 'new') { %><th>Type</th><th>Added</th>
          <% } else { %><th>Type</th><th>Now</th><% } %>
          <th class="d-none d-xl-table-cell">Usual contact</th>
        </tr></thead>
        <tbody>
          <% list.forEach((v) => { %>
            <tr>
              <td><a class="jt-row-link" href="/vehicles/<%= v.id %>"><% if (v.reg_no) { %><%- include('partials/plate', { reg: v.reg_no }) %><% } else { %><span class="font-monospace small"><%= v.chassis_no ?? v.temp_tag %></span><% } %></a></td>
              <td><%= [v.make, v.model].filter(Boolean).join(' ') || '—' %><% if (v.body_type) { %><span class="jt-sub"><%= v.body_type %></span><% } %></td>
              <td><a href="/customers/<%= v.customer_id %>"><%= v.customer_name %></a></td>
              <% if (place === 'in') { %>
                <td><%= v.open_site %></td>
                <td><a class="font-monospace small" href="/check-in/<%= v.open_id %>"><%= v.open_number %></a></td>
                <td class="text-end text-nowrap jt-num"><%= daysIn(v.open_since) %></td>
              <% } else if (place === 'left') { %>
                <td class="text-nowrap"><%= v.last_left_at ? fmt.date(v.last_left_at) : '—' %></td>
                <td class="text-end jt-num"><%= v.visits %></td>
              <% } else if (place === 'new') { %>
                <td><%= typeLabel(v.type) %></td>
                <td class="text-nowrap"><%= fmt.date(v.created_at) %></td>
              <% } else { %>
                <td><%= typeLabel(v.type) %></td>
                <td>
                  <% if (v.open_id) { %><%- include('partials/pill', { text: `In at ${v.open_site}`, tone: 'info' }) %>
                  <% } else if (Number(v.visits) > 0) { %><span class="text-body-secondary small">Left <%= v.last_left_at ? fmt.date(v.last_left_at) : '' %></span>
                  <% } else { %><span class="text-body-secondary small">Not yet visited</span><% } %>
                </td>
              <% } %>
              <td class="d-none d-xl-table-cell text-body-secondary"><%= v.contact_name ?? '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
