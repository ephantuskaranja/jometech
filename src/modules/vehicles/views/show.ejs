<section class="card mb-4">
  <div class="card-body jt-record">
    <div class="jt-crumb">Sales <i class="bi bi-chevron-right"></i><a href="/vehicles">Vehicles</a><i class="bi bi-chevron-right"></i><span><%= vehicleLabel(vehicle) %></span></div>
    <div class="jt-record-top">
      <% if (vehicle.reg_no) { %><%- include('partials/plate', { reg: vehicle.reg_no, size: 'lg' }) %><% } %>
      <div class="jt-record-title">
        <h1 class="h3"><%= [vehicle.make, vehicle.model].filter(Boolean).join(' ') || typeLabel(vehicle.type) %><% if (vehicle.year) { %> <span class="text-body-tertiary fw-normal"><%= vehicle.year %></span><% } %></h1>
        <div class="jt-meta">
          <span><i class="bi bi-person"></i><a href="/customers/<%= vehicle.customer_id %>"><%= vehicle.customer_name %></a></span>
          <span><i class="bi bi-telephone"></i><span class="font-monospace"><%= fmt.phone(vehicle.customer_phone) %></span></span>
          <span><i class="bi bi-truck"></i><%= typeLabel(vehicle.type) %><%= vehicle.body_type ? ` · ${vehicle.body_type}` : '' %></span>
        </div>
      </div>
      <div class="jt-page-actions">
        <% if (canEdit) { %><a class="btn btn-outline-secondary" href="/vehicles/<%= vehicle.id %>/edit"><i class="bi bi-pencil"></i>Edit</a><% } %>
        <% if (canCheckIn) { %><a class="btn btn-primary" href="/check-in/new?vehicle_id=<%= vehicle.id %>"><i class="bi bi-box-arrow-in-right"></i>Check in</a><% } %>
      </div>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-lg-7 d-grid gap-4 align-content-start">
    <%# Every check-in of this vehicle, newest first. %>
    <section class="card">
      <div class="card-header d-flex align-items-center"><h2 class="h6 mb-0 me-auto">Visits</h2><span class="small text-body-secondary"><%= visits.length %></span></div>
      <% if (visits.length === 0) { %>
        <div class="card-body text-body-secondary small">Not checked in yet.<% if (canCheckIn) { %> Use <strong>Check in</strong> above when it arrives.<% } %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table jt-table mb-0">
            <thead><tr><th>Check-in</th><th>Site</th><th>Arrived</th><th>Left</th><th class="text-end">Days in</th></tr></thead>
            <tbody>
              <% visits.forEach((c) => { const st = statuses[c.status]; %>
                <tr>
                  <td>
                    <% if (mySiteIds.includes(c.site_id)) { %><a class="font-monospace small jt-row-link" href="/check-in/<%= c.id %>"><%= c.number %></a><% } else { %><span class="font-monospace small"><%= c.number %></span><% } %>
                    <% if (c.status !== 'checked_out') { %><span class="d-block mt-1"><%- include('partials/pill', { text: st.label, tone: st.tone }) %></span><% } %>
                    <% if (c.brought_by) { %><span class="jt-sub">By <%= c.brought_by %></span><% } %>
                  </td>
                  <td><%= c.site_name %></td>
                  <td class="text-nowrap"><%= fmt.date(c.checked_in_at) %><% if (c.odometer_km != null) { %><span class="jt-sub"><%= fmt.qty(c.odometer_km) %> km</span><% } %></td>
                  <td class="text-nowrap"><%= c.checked_out_at ? fmt.date(c.checked_out_at) : '—' %></td>
                  <td class="text-end text-nowrap jt-num"><%= c.status === 'cancelled' ? '—' : daysIn(c.checked_in_at, c.checked_out_at ?? new Date()) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Details</h2></div>
      <div class="card-body">
        <dl class="jt-kv">
          <div><dt>Reg number</dt><dd><%= vehicle.reg_no ?? '—' %></dd></div>
          <div><dt>Chassis number</dt><dd class="font-monospace"><%= vehicle.chassis_no ?? '—' %></dd></div>
          <% if (vehicle.temp_tag) { %><div><dt>Temporary tag</dt><dd class="font-monospace"><%= vehicle.temp_tag %></dd></div><% } %>
          <div><dt>Colour</dt><dd><%= vehicle.colour ?? '—' %></dd></div>
          <div><dt>Added</dt><dd><%= fmt.date(vehicle.created_at) %></dd></div>
        </dl>
        <% if (vehicle.notes) { %><p class="mt-3 mb-0 text-body-secondary" style="white-space: pre-line"><%= vehicle.notes %></p><% } %>
      </div>
    </section>
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">Usual contact</h2></div>
      <% if (vehicle.contact_name) { %>
        <div class="jt-contact">
          <span class="jt-avatar"><%= vehicle.contact_name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase() %></span>
          <div class="jt-contact-main">
            <strong><%= vehicle.contact_name %></strong>
            <span class="small text-body-secondary"><%= [vehicle.contact_role, vehicle.contact_phone && fmt.phone(vehicle.contact_phone)].filter(Boolean).join(' · ') || '—' %></span>
          </div>
        </div>
      <% } else { %>
        <div class="card-body text-body-secondary small">No contact person set. The customer’s own number is <span class="font-monospace"><%= fmt.phone(vehicle.customer_phone) %></span>.</div>
      <% } %>
    </section>
  </div>
  <div class="col-lg-5">
    <section class="card">
      <div class="card-header"><h2 class="h6 mb-0">History</h2></div>
      <div class="card-body">
        <%- include('partials/history', { entries, labels: { reg_no: 'Reg', chassis_no: 'Chassis', temp_tag: 'Temporary tag', customer: 'Owner', contact: 'Usual contact', type: 'Type', make: 'Make', model: 'Model', year: 'Year', body_type: 'Body', colour: 'Colour', notes: 'Notes' } }) %>
      </div>
    </section>
  </div>
</div>
