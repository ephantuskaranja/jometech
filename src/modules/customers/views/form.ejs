<%# Add and edit customer. Only name and phone are required; the rest sits under "More details". %>
<%
  const editing = Boolean(customer);
  const hasMore = Boolean(values.email || values.kra_pin || values.town || values.address || values.notes || Number(values.credit_days) || errors.email || errors.kra_pin);
%>
<%- include('partials/page-header', {
  crumb: ['Sales', { label: 'Customers', href: '/customers' }, editing ? customer.name : 'Add customer'],
  heading: editing ? `Edit ${customer.name}` : 'Add customer',
  sub: editing ? `${customer.number}. Changes are recorded in the customer’s history.` : 'A name and phone number are enough. The customer number is given when you save.',
}) %>

<form method="post" action="<%= editing ? `/customers/${customer.id}` : '/customers' %>" novalidate class="col-xl-9"
      x-data="{ category: '<%= values.category %>', more: <%= hasMore %> }">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card mb-4">
    <div class="card-body d-grid gap-4">
      <%- include('partials/choices', { name: 'category', label: 'Type of customer', options: categories, value: values.category, columns: 4, model: 'category' }) %>

      <div class="jt-fields">
        <%- include('partials/field', { name: 'name', label: 'Name', value: values.name, error: errors.name, required: true, autocomplete: 'off', placeholder: 'e.g. Mwangi Transporters or John Kariuki' }) %>
        <div class="jt-field" x-data="phoneCheck(<%= editing ? customer.id : 'null' %>)">
          <%- include('partials/field', { name: 'phone', label: 'Phone number', type: 'tel', value: editing && values.phone === customer.phone ? fmt.phone(values.phone) : values.phone, error: errors.phone, required: true, placeholder: '0712 345 678', autocomplete: 'off', attrs: '@blur="check($el.value)"' }) %>
          <template x-for="m in matches" :key="m.id">
            <div class="jt-warn-box"><i class="bi bi-exclamation-triangle"></i>
              <span>Existing customer with this number: <strong x-text="m.name"></strong> (<span x-text="m.number"></span>). <a :href="`/customers/${m.id}`">Use this customer</a></span>
            </div>
          </template>
        </div>
      </div>

      <%# A company's first contact person, e.g. the salesman who brings their vehicles in. Only when adding. %>
      <% if (!editing) { %>
        <div x-show="category !== 'individual'" x-cloak class="d-grid gap-2">
          <h3 class="h6 mb-0">Contact person <span class="text-body-tertiary fw-normal">(optional)</span></h3>
          <p class="form-text mt-0">Who you deal with, e.g. the salesman who brings their vehicles in. You can add more later.</p>
          <div class="jt-fields">
            <%- include('partials/field', { name: 'contact_name', label: 'Name', value: values.contact_name, error: errors.contact_name, autocomplete: 'off' }) %>
            <%- include('partials/field', { name: 'contact_role', label: 'Role', value: values.contact_role, error: errors.contact_role, placeholder: 'e.g. Salesman, Fleet manager' }) %>
            <%- include('partials/field', { name: 'contact_phone', label: 'Phone', type: 'tel', value: values.contact_phone, error: errors.contact_phone, placeholder: '0712 345 678' }) %>
          </div>
        </div>
      <% } %>

      <div>
        <button class="btn btn-link p-0" type="button" @click="more = !more" :aria-expanded="more">
          More details (optional) <i class="bi" :class="more ? 'bi-chevron-up' : 'bi-chevron-down'"></i>
        </button>
      </div>
      <div class="jt-fields" x-show="more" x-cloak>
        <%- include('partials/field', { name: 'email', label: 'Email', type: 'email', value: values.email, error: errors.email }) %>
        <%- include('partials/field', { name: 'kra_pin', label: 'KRA PIN', value: values.kra_pin, error: errors.kra_pin, placeholder: 'A123456789B', hint: 'Needed for tax invoices.' }) %>
        <%- include('partials/field', { name: 'town', label: 'Town', value: values.town, error: errors.town, placeholder: 'e.g. Nakuru' }) %>
        <%- include('partials/field', { name: 'credit_days', label: 'Payment terms', type: 'select', value: String(values.credit_days ?? 0), options: creditTerms.map((t) => ({ value: t.value, label: t.label })) }) %>
        <%- include('partials/field', { name: 'address', label: 'Address', value: values.address, error: errors.address, class: 'jt-full', placeholder: 'Building, street, P.O. Box' }) %>
        <%- include('partials/field', { name: 'notes', label: 'Notes', type: 'textarea', value: values.notes, error: errors.notes, class: 'jt-full', rows: 2 }) %>
      </div>
    </div>
  </section>

  <div class="jt-savebar">
    <span class="jt-savebar-note"><i class="bi bi-lightning-charge"></i><%= editing ? 'Saved changes appear in the customer’s history.' : 'Payment terms start as Cash.' %></span>
    <div class="jt-savebar-actions">
      <a class="btn btn-outline-secondary" href="<%= editing ? `/customers/${customer.id}` : '/customers' %>">Cancel</a>
      <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i><%= editing ? 'Save changes' : 'Add customer' %></button>
    </div>
  </div>
</form>
