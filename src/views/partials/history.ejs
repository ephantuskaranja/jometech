<%#
  History of one record (from the audit trail), newest first.
  include('partials/history', { entries, labels: { name: 'Name', roles: 'Role' } })

  entries   from history(entity, id) in src/core/audit.js
  labels    field → label people understand; fields not listed use their own name
%>
<%
  const phrases = {
    create: 'added this',
    update: 'changed',
    delete: 'deleted this',
    password_reset: 'reset the password',
    password_changed: 'changed their password',
    switched_off: 'switched the account off',
    switched_on: 'switched the account back on',
    login: 'logged in',
    locked: 'locked after too many wrong passwords',
    signed: 'recorded the driver’s signature',
    not_signed: 'saved it without the driver’s signature',
    photo_added: 'added a photo',
    photo_deleted: 'deleted a photo',
    checked_out: 'checked it out',
    released: 'released it to the person collecting',
    gate_cleared: 'cleared it out at the gate',
    release_allowed: 'allowed the release',
    release_withdrawn: 'withdrew permission to release',
    attendance_saved: 'saved attendance',
    attendance_confirmed: 'confirmed the day',
    attendance_reopened: 'reopened the day',
    recalculated: 'worked it out again',
    adjusted: 'changed an adjustment',
    payroll_checked: 'checked the days',
    payroll_reopened: 'put it back to draft',
    payroll_approved: 'approved it',
    payroll_paid: 'recorded payment',
    payroll_closed: 'closed it',
    sent: 'sent it to another site',
    received: 'received it',
    move_cancelled: 'cancelled a move',
    site_chosen: 'chose a site at login',
    visitor_in: 'signed the visitor in',
    visitor_received: 'confirmed the visitor was received',
    visitor_cleared: 'cleared the visitor out',
    note: 'added a note',
    won: 'closed it as won',
    lost: 'closed it as lost',
    reopened: 'reopened it',
    customer_linked: 'linked it to a customer',
    quoted: 'sent a proforma',
    proforma_sent: 'marked it as sent to the customer',
    accepted: 'marked it accepted',
    declined: 'marked it declined',
    revised: 'made a revision',
    record_off: 'switched it off',
    record_on: 'switched it back on',
    merged: 'moved items in from another category',
    checked: 'checked the file',
    approved: 'approved it',
    rejected: 'rejected it',
    cancelled: 'cancelled it',
    stock_adjusted: 'adjusted stock',
    posted: 'posted it',
    gate_out: 'let it out of the gate',
    gate_in: 'logged it in at the gate',
    downloaded: 'downloaded it',
    po_submitted: 'sent it for approval',
    po_approved: 'approved it',
    po_sent: 'marked it as sent to the supplier',
    po_redraft: 'took it back to draft',
    po_cancelled: 'cancelled it',
    materials_issued: 'issued materials',
    opening_stock: 'added opening stock',
    opening_undone: 'undid opening stock',
    materials_returned: 'returned materials to the store',
    po_received: 'received goods against it',
    po_receipt_reversed: 'reversed a delivery on it',
    po_closed: 'closed it: nothing more is coming',
    grn_reversed: 'reversed it',
    price_changed: 'price updated from goods received',
    job_created: 'started a job from it',
    step_done: 'finished a step',
    step_skipped: 'skipped a step',
    step_undone: 'undid a step',
    job_started: 'started the job',
    job_completed: 'marked it completed',
    job_cancelled: 'cancelled it',
    job_moved: 'received the vehicle at another site',
    vehicle_arrived: 'checked the vehicle in',
    revealed: 'viewed a hidden detail',
  };
  // Personal details stay masked in the history too.
  const masked = { id_no: 'id', kra_pin: 'id', driver_id_no: 'id', collector_id_no: 'id', mpesa_phone: 'phone' };
  const show = (v) => {
    if (v === null || v === undefined || v === '') return '—';
    if (Array.isArray(v)) return v.length ? v.join(', ') : '—';
    if (typeof v === 'boolean') return v ? 'Yes' : 'No';
    if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(v)) return fmt.dateTime(v);
    return v;
  };
  const fieldLabels = locals.labels ?? {};
%>
<% if (!entries.length) { %>
  <p class="text-body-secondary small mb-0">No changes recorded yet.</p>
<% } else { %>
  <ol class="jt-timeline">
    <% entries.forEach((e) => { const changes = Object.entries(e.changes ?? {}); %>
      <li class="jt-timeline-item<%= e.action === 'login' ? ' is-quiet' : '' %>">
        <div><strong><%= e.by ?? 'System' %></strong> <%= phrases[e.action] ?? e.action.replaceAll('_', ' ') %></div>
        <% if (changes.length) { %>
          <ul class="jt-changes">
            <% changes.forEach(([field, [rawBefore, rawAfter]]) => {
                 const [before, after] = masked[field] ? [rawBefore, rawAfter].map((v) => (v ? fmt.mask(v, masked[field]) : v)) : [rawBefore, rawAfter]; %>
              <li>
                <span class="jt-changes-field"><%= fieldLabels[field] ?? field.replaceAll('_', ' ') %></span>
                <% if (e.action === 'create') { %><%= show(after) %>
                <% } else { %><span class="jt-changes-old"><%= show(before) %></span> <i class="bi bi-arrow-right"></i> <%= show(after) %><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <% if (e.summary) { %><div class="small text-body-secondary"><%= e.summary %></div><% } %>
        <time class="small text-body-tertiary" datetime="<%= new Date(e.created_at).toISOString() %>"><%= fmt.dateTime(e.created_at) %></time>
      </li>
    <% }) %>
  </ol>
<% } %>
