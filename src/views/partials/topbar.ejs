<header class="jt-topbar">
  <button class="btn jt-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
    <i class="bi bi-list"></i>
  </button>

  <%# Global search: the box is in place now; results arrive with the customers & vehicles module. %>
  <form class="jt-search" role="search" id="global-search-form">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input class="form-control" type="search" name="q" id="global-search" autocomplete="off"
           placeholder="Search reg no., chassis, phone, job no. or customer" aria-label="Search">
    <kbd class="d-none d-md-inline">/</kbd>
  </form>

  <div class="jt-topbar-end">
    <%# Current site. A dropdown only when the user works at more than one. %>
    <% if (!site) { %>
      <span class="jt-site-pill text-warning-emphasis" title="Ask an administrator to give you a site"><i class="bi bi-exclamation-triangle"></i><span class="d-none d-md-inline">No site</span></span>
    <% } else if (user.sites.length === 1) { %>
      <span class="jt-site-pill" title="Current site"><span class="jt-dot"></span><span class="d-none d-md-inline"><%= site.name %></span></span>
    <% } else { %>
      <div class="dropdown">
        <button class="jt-site-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Change site">
          <span class="jt-dot"></span><span class="d-none d-md-inline"><%= site.name %></span><i class="bi bi-chevron-down small"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
          <h6 class="dropdown-header">Working at</h6>
          <% user.sites.forEach((s) => { %>
            <form method="post" action="/account/site">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="site_id" value="<%= s.id %>">
              <input type="hidden" name="next" value="<%= path %>">
              <button class="dropdown-item<%= s.id === site.id ? ' active' : '' %>" type="submit"><%= s.name %><% if (s.id === site.id) { %><i class="bi bi-check2 ms-auto"></i><% } %></button>
            </form>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="dropdown">
      <button class="btn jt-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Change theme" title="Theme">
        <i class="bi bi-circle-half" data-theme-icon></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end jt-theme-menu">
        <li><h6 class="dropdown-header">Theme</h6></li>
        <li><button class="dropdown-item" type="button" data-theme-value="light"><i class="bi bi-sun"></i>Light<i class="bi bi-check2 jt-check"></i></button></li>
        <li><button class="dropdown-item" type="button" data-theme-value="dark"><i class="bi bi-moon-stars"></i>Dark<i class="bi bi-check2 jt-check"></i></button></li>
        <li><button class="dropdown-item" type="button" data-theme-value="system"><i class="bi bi-circle-half"></i>Match device<i class="bi bi-check2 jt-check"></i></button></li>
      </ul>
    </div>

    <div class="dropdown">
      <button class="btn jt-me" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
        <span class="jt-avatar"><%= user.initials %></span>
        <span class="jt-me-text d-none d-md-block"><%= user.name %><small><%= user.roleNames %></small></span>
        <i class="bi bi-chevron-down small d-none d-md-inline"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li class="jt-me-head">
          <strong><%= user.name %></strong>
          <span><%= formatPhone(user.phone) %></span>
          <span><%= user.roleNames %></span>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/account/password"><i class="bi bi-key"></i>Change password</a></li>
        <li>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i>Log out</button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</header>
