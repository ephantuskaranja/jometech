<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title === appName ? appName : `${title} · ${appName}` %></title>

  <%# Must run before the CSS so the page never flashes the wrong theme. %>
  <script src="/js/theme.js"></script>

  <link rel="stylesheet" href="/vendor/fonts/archivo/500.css">
  <link rel="stylesheet" href="/vendor/fonts/archivo/600.css">
  <link rel="stylesheet" href="/vendor/fonts/archivo/700.css">
  <link rel="stylesheet" href="/vendor/fonts/figtree/400.css">
  <link rel="stylesheet" href="/vendor/fonts/figtree/500.css">
  <link rel="stylesheet" href="/vendor/fonts/figtree/600.css">
  <link rel="stylesheet" href="/vendor/fonts/ibm-plex-mono/500.css">
  <link rel="stylesheet" href="/vendor/fonts/ibm-plex-mono/600.css">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">

  <script defer src="/vendor/alpinejs/cdn.min.js"></script>
</head>
<body>
  <a class="visually-hidden-focusable jt-skip" href="#main">Skip to content</a>
  <div class="jt-shell">
    <%- include('partials/sidebar') %>
    <div class="jt-main">
      <%- include('partials/topbar') %>
      <main class="jt-content" id="main">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
