<!doctype html>
<%# data-user-theme: the theme saved on the account; theme.js applies it. %>
<html lang="en" data-bs-theme="light" data-user-theme="<%= user ? user.theme : '' %>">
<head>
<%- include('partials/head') %>
</head>
<body>
  <a class="visually-hidden-focusable jt-skip" href="#main">Skip to content</a>
  <div class="jt-shell">
    <%- include('partials/sidebar') %>
    <div class="jt-main">
      <%- include('partials/topbar') %>
      <main class="jt-content" id="main">
        <%- include('partials/flash') %>
        <%- body %>
      </main>
    </div>
  </div>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/tom-select/js/tom-select.complete.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
